<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task" Width="860" Height="720" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13" Background="White">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinWidth" Value="80"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0F6CBD"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#0F6CBD"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,4,0,8"/>
    </Style>
    <Style TargetType="Label">
      <Setter Property="Padding" Value="0,4,8,4"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#5B6170"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,10,0,6"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Problems and buttons -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="16,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="BtnSave" Content="Save" Style="{StaticResource Primary}"/>
          <Button x:Name="BtnCancel" Content="Cancel" Margin="0"/>
        </StackPanel>
        <TextBlock x:Name="TxtProblems" Foreground="#B91C1C" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
      </DockPanel>
    </Border>

    <ScrollViewer x:Name="Page0" VerticalScrollBarVisibility="Auto" Padding="24,18">
      <StackPanel>
        <TextBlock Style="{StaticResource Title}" Text="Task"/>
        <TextBlock Style="{StaticResource Hint}" Text="A script the deployment runs. It is kept in Tasks\&lt;name&gt; in the content root and goes onto USB sticks with the answer files that use it."/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <Label Content="Name"/>
          <TextBox x:Name="TxtName" Grid.Column="1" ToolTip="Folder name under Tasks. Letters, digits, dot, dash and underscore."/>
          <Label Grid.Row="1" Content="Description"/>
          <TextBox x:Name="TxtDescription" Grid.Row="1" Grid.Column="1"/>
          <Label Grid.Row="2" Content="When it runs"/>
          <ComboBox x:Name="CmbPhase" Grid.Row="2" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                    ToolTip="The default when an answer file adds this task; the answer file can change it."/>
          <TextBlock x:Name="TxtPhaseNote" Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
        </Grid>

        <TextBlock Style="{StaticResource Heading}" Text="Script"/>
        <TextBlock Style="{StaticResource Hint}" Text="Type the script below, or import a script file, or a folder when the script needs other files next to it (they are copied into the task's folder). The file name says how it runs: .ps1 with PowerShell, .cmd or .bat with cmd, .exe as a program. Nobody can click through it, so it must not wait for input."/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <Label Content="Import from"/>
          <TextBox x:Name="TxtSource" Grid.Column="1" ToolTip="Optional. Copied into Tasks\&lt;name&gt; when you save. When editing, leave empty to keep the files already there."/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,8">
            <Button x:Name="BtnSourceFile" Content="File..."/>
            <Button x:Name="BtnSourceFolder" Content="Folder..." Margin="0"/>
          </StackPanel>
          <Label Grid.Row="1" Content="Script file"/>
          <ComboBox x:Name="CmbScript" Grid.Row="1" Grid.Column="1" IsEditable="True" ToolTip="The file in the task's folder to run, such as script.ps1."/>
          <TextBlock x:Name="TxtType" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
        </Grid>
        <TextBox x:Name="TxtScript" Height="260" FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>

        <TextBlock Style="{StaticResource Heading}" Text="How it runs"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <Label Content="Arguments"/>
          <TextBox x:Name="TxtArguments" Grid.Column="1" FontFamily="Consolas" ToolTip="Passed to the script. An answer file can add more arguments for its own use of the task."/>
          <Label Grid.Row="1" Content="Success exit codes"/>
          <TextBox x:Name="TxtCodes" Grid.Row="1" Grid.Column="1" Width="200" HorizontalAlignment="Left"/>
          <Label Grid.Row="2" Content="Timeout (minutes)"/>
          <TextBox x:Name="TxtTimeout" Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left" ToolTip="The script is stopped and marked failed after this long."/>
          <CheckBox x:Name="ChkStop" Grid.Row="3" Grid.Column="1">
            <TextBlock TextWrapping="Wrap" Text="Stop the deployment when it fails (POSTIMAGE only; at first boot or logon a failure is logged and shown as a warning)"/>
          </CheckBox>
          <TextBlock x:Name="TxtCommandLine" Grid.Row="4" Grid.Column="1" Style="{StaticResource Hint}" FontFamily="Consolas" Margin="0,0,0,8"/>
        </Grid>

        <TextBlock Style="{StaticResource Heading}" Text="Which PCs"/>
        <TextBlock Style="{StaticResource Hint}" Text="Leave both empty to run on every PC. Otherwise the task only runs when the PC's maker and model match (comma-separated, wildcards allowed: Latitude*, ThinkPad T14*). Lenovo models also match their 4-character machine type."/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <Label Content="Makers"/>
          <TextBox x:Name="TxtMakers" Grid.Column="1" ToolTip="Dell, HP, Lenovo, or the manufacturer as WMI reports it."/>
          <Label Grid.Row="1" Content="Models"/>
          <TextBox x:Name="TxtModels" Grid.Row="1" Grid.Column="1"/>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
