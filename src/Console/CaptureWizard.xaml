<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture Wizard" Width="760" Height="620" MinWidth="620" MinHeight="460" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13" Background="White">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="MinWidth" Value="90"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0F6CBD"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#0F6CBD"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Label">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Long check box and option labels wrap instead of running off the right edge. -->
    <DataTemplate x:Key="WrapLabel">
      <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
    </DataTemplate>
    <Style TargetType="CheckBox">
      <Setter Property="ContentTemplate" Value="{StaticResource WrapLabel}"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="ContentTemplate" Value="{StaticResource WrapLabel}"/>
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="#374151"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="StepLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,6"/>
      <Setter Property="Foreground" Value="#9CA3AF"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Step list -->
    <Border DockPanel.Dock="Left" Width="180" Background="#1F2937" Padding="18,20">
      <StackPanel>
        <TextBlock Text="Capture an image" Foreground="White" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,16"/>
        <TextBlock x:Name="Step0" Text="1. Reference machine" Style="{StaticResource StepLabel}"/>
        <TextBlock x:Name="Step1" Text="2. Run sysprep" Style="{StaticResource StepLabel}"/>
        <TextBlock x:Name="Step2" Text="3. Check the disk" Style="{StaticResource StepLabel}"/>
        <TextBlock x:Name="Step3" Text="4. Image details" Style="{StaticResource StepLabel}"/>
        <TextBlock x:Name="Step4" Text="5. Summary" Style="{StaticResource StepLabel}"/>
      </StackPanel>
    </Border>

    <!-- Buttons -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="16,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnBack" Content="Back"/>
        <Button x:Name="BtnNext" Content="Next" Style="{StaticResource Primary}"/>
        <Button x:Name="BtnCancel" Content="Cancel"/>
      </StackPanel>
    </Border>

    <Grid Margin="24,20">
      <!-- Page 1: reference machine -->
      <ScrollViewer x:Name="Page0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Style="{StaticResource Title}" Text="Where is the reference machine?"/>
          <TextBlock Style="{StaticResource Body}"
                     Text="Build the reference in a VM if you can: Windows 10 or 11, updates and your apps, no OEM drivers."/>
          <RadioButton x:Name="RbDiskFile" GroupName="Ref" Content="A VM's disk file on this PC (VMware, VirtualBox and others, recommended)" FontWeight="SemiBold" Margin="0,6,0,4"/>
          <TextBlock Style="{StaticResource Body}" Margin="22,0,0,6"
                     Text="You run the prepare command in the VM once (next page); sysprep shuts the VM down. Then the tool copies the VM's disk on this PC and captures it. No ISO, no password, nothing installed in the VM. VMDK, VDI and qcow2 disks need QEMU's qemu-img on this PC; VHD and VHDX need nothing. For VMware, pick the VM's .vmdk: when it has snapshots, the newest one is read."/>
          <TextBlock x:Name="TxtDiskFileStatus" Style="{StaticResource Body}" Margin="22,0,0,6" Foreground="#B91C1C" Visibility="Collapsed"/>
          <DockPanel Margin="22,0,0,12">
            <Button x:Name="BtnDiskFileBrowse" DockPanel.Dock="Right" Content="Browse..."/>
            <TextBox x:Name="TxtDiskFile" ToolTip="The VM's disk file: .vmdk, .vhdx, .vhd, .vdi or .qcow2"/>
          </DockPanel>

          <RadioButton x:Name="RbIso" GroupName="Ref" Content="A VM or a PC that boots from an ISO" FontWeight="SemiBold" Margin="0,6,0,4"/>
          <TextBlock Style="{StaticResource Body}" Margin="22,0,0,6"
                     Text="You run sysprep yourself, then attach the capture ISO. The machine saves the image to the network share."/>
          <DockPanel Margin="22,0,0,12">
            <Button x:Name="BtnIsoFolder" DockPanel.Dock="Right" Content="Browse..."/>
            <TextBox x:Name="TxtIsoFolder" ToolTip="Folder for Capture-WinPE.iso"/>
          </DockPanel>

          <RadioButton x:Name="RbUsb" GroupName="Ref" Content="A physical PC, with a USB stick" FontWeight="SemiBold" Margin="0,6,0,4"/>
          <TextBlock Style="{StaticResource Body}" Margin="22,0,0,6"
                     Text="You run sysprep yourself. Erases the stick and makes it capture media; the image is saved on the stick's DEPLOY partition, copy it to the content root afterwards."/>
          <DockPanel Margin="22,0,0,0">
            <Button x:Name="BtnUsbRefresh" DockPanel.Dock="Right" Content="Refresh"/>
            <ComboBox x:Name="CmbUsb" DisplayMemberPath="Label"/>
          </DockPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Page 2: sysprep -->
      <ScrollViewer x:Name="Page1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock x:Name="TxtPrepTitle" Style="{StaticResource Title}" Text="Run sysprep on the reference machine"/>
          <CheckBox x:Name="ChkSysprepAtDeploy" Margin="0,0,0,10"
                    Content="Skip sysprep here: each PC runs sysprep at its first start (5-10 minutes more per PC, try it on one PC first)"/>
          <TextBlock x:Name="TxtPrepIntro" Style="{StaticResource Body}" Text="The tool cannot reach this machine's Windows by itself, so prepare it by hand. Run this in an elevated PowerShell window on the reference machine. It checks for a pending reboot, BitLocker and Store apps that break sysprep, then runs sysprep and shuts the machine down."/>
          <DockPanel Margin="0,0,0,8">
            <Button x:Name="BtnCopyCmd" DockPanel.Dock="Right" Content="Copy"/>
            <TextBox x:Name="TxtPrepCmd" IsReadOnly="True" FontFamily="Consolas"/>
          </DockPanel>
          <TextBlock x:Name="TxtPrepHint" Style="{StaticResource Body}" Foreground="#6B7280"
                     Text="Add -CheckOnly to only report problems, or -RemoveUserApps to remove the Store apps that block sysprep."/>
          <CheckBox x:Name="ChkPrepared" Margin="0,12,0,0"
                    Content="The reference machine has been prepared with sysprep and is shut down"/>
        </StackPanel>
      </ScrollViewer>

      <!-- Page 3: check the disk (VM disk file only; the other choices skip it) -->
      <ScrollViewer x:Name="Page2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Style="{StaticResource Title}" Text="Check the disk"/>
          <TextBlock Style="{StaticResource Body}"
                     Text="The tool checks the VM's disk on this PC and reads the Windows on it before capturing. Nothing in the VM or its disk is changed. Next is available once every line has a tick."/>
          <ItemsControl x:Name="LstChecks">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Mark}" Foreground="{Binding Color}" FontWeight="Bold" FontSize="15"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Detail}" Foreground="#4B5563" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ProgressBar x:Name="BarCheck" Height="8" Margin="26,6,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"
                       Foreground="#0F6CBD" Background="#E8EAEE" BorderThickness="0"/>
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="BtnCheckAgain" Content="Check again" Margin="0"/>
            <Button x:Name="BtnCheckLog" Content="Open log" IsEnabled="False"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Page 4: image details -->
      <ScrollViewer x:Name="Page3" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Style="{StaticResource Title}" Text="Image details"/>
          <TextBlock Style="{StaticResource Body}" Text="The image is saved to the Images folder of the content root."/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition/><RowDefinition Height="10"/><RowDefinition/><RowDefinition Height="10"/><RowDefinition/>
              <RowDefinition Height="16"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/>
            </Grid.RowDefinitions>
            <Label Content="Name"/>
            <TextBox x:Name="TxtName" Grid.Column="1" ToolTip="Letters, digits, dot, dash and underscore. Becomes the file name."/>
            <Label Grid.Row="2" Content="Description"/>
            <TextBox x:Name="TxtDescription" Grid.Row="2" Grid.Column="1"/>
            <Label Grid.Row="4" Content="Compression"/>
            <ComboBox x:Name="CmbCompression" Grid.Row="4" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectedIndex="0">
              <ComboBoxItem Content="Maximum (smaller, slower)" Tag="max"/>
              <ComboBoxItem Content="Fast (larger, quicker)" Tag="fast"/>
            </ComboBox>
            <CheckBox x:Name="ChkSplit" Grid.Row="6" Grid.Column="1"
                      Content="Split into 3.8 GB parts (only needed to store the image on a FAT32 drive)"/>
            <CheckBox x:Name="ChkUnattended" Grid.Row="8" Grid.Column="1" IsChecked="True"
                      Content="Start without asking and shut down when done"/>
            <CheckBox x:Name="ChkNewVersion" Grid.Row="10" Grid.Column="1"
                      Content="If an image with this name exists, replace it and keep the old one as an earlier version"
                      ToolTip="The old image moves to Images\Previous only after the new capture succeeds. Answer files pinned to a version are not affected."/>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- Page 5: summary -->
      <DockPanel x:Name="Page4" Visibility="Collapsed">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}" Text="Summary"/>
        <TextBlock x:Name="TxtSummaryIntro" DockPanel.Dock="Top" Style="{StaticResource Body}"
                   Text="Clicking Build and start opens a window that builds the capture media (a few minutes). Boot the reference machine from it to capture. The new image appears on the Images tab when it finishes."/>
        <TextBlock x:Name="TxtIssues" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="#B91C1C" Margin="0,10,0,0"/>
        <TextBox x:Name="TxtSummary" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap"
                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Background="#F9FAFB"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
