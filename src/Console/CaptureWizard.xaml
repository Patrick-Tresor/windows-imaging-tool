<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture Wizard" Width="760" Height="620" MinWidth="620" MinHeight="460" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <!-- Long check box and option labels wrap instead of running off the right edge. -->
    <DataTemplate x:Key="WrapLabel">
      <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
    </DataTemplate>
    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="ContentTemplate" Value="{StaticResource WrapLabel}"/>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
      <Setter Property="ContentTemplate" Value="{StaticResource WrapLabel}"/>
    </Style>
    <Style x:Key="StepLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,7"/>
      <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Step list -->
    <Border DockPanel.Dock="Left" Width="190" Background="{DynamicResource SidebarBrush}" Padding="20,24">
      <StackPanel>
        <Image x:Name="ImgLogo" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="Capture an image" Foreground="White" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,20"/>
        <TextBlock x:Name="Step0" Text="1. Reference machine" Style="{StaticResource StepLabel}"/>
        <TextBlock x:Name="Step1" Text="2. Run sysprep" Style="{StaticResource StepLabel}"/>
        <TextBlock x:Name="Step2" Text="3. Check the disk" Style="{StaticResource StepLabel}"/>
        <TextBlock x:Name="Step3" Text="4. Image details" Style="{StaticResource StepLabel}"/>
        <TextBlock x:Name="Step4" Text="5. Summary" Style="{StaticResource StepLabel}"/>
      </StackPanel>
    </Border>

    <!-- Buttons -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnBack" Content="Back"/>
        <Button x:Name="BtnNext" Content="Next" Style="{StaticResource Primary}"/>
        <Button x:Name="BtnCancel" Content="Cancel"/>
      </StackPanel>
    </Border>

    <Grid Margin="24,20">
      <!-- Page 1: reference machine -->
      <ScrollViewer x:Name="Page0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Style="{StaticResource Title}" Text="Where is the reference machine?"/>
          <TextBlock Style="{StaticResource Body}"
                     Text="Build the reference in a VM if you can: Windows 10 or 11, updates and your apps, no OEM drivers."/>
          <TextBlock Text="The VM's disk file on this PC (VMware, VirtualBox and others)" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,4"/>
          <TextBlock Style="{StaticResource Body}" Margin="22,0,0,6"
                     Text="You run the prepare command in the VM once (next page); sysprep shuts the VM down. Then the tool copies the VM's disk on this PC and captures it. No ISO, no password, nothing installed in the VM. VMDK, VDI and qcow2 disks need QEMU's qemu-img on this PC; VHD and VHDX need nothing. For VMware, pick the VM's .vmdk: when it has snapshots, the newest one is read."/>
          <TextBlock x:Name="TxtDiskFileStatus" Style="{StaticResource Body}" Margin="22,0,0,6" Foreground="{DynamicResource ErrorBrush}" Visibility="Collapsed"/>
          <DockPanel Margin="22,0,0,12">
            <Button x:Name="BtnDiskFileBrowse" DockPanel.Dock="Right" Content="Browse..."/>
            <TextBox x:Name="TxtDiskFile" ToolTip="The VM's disk file: .vmdk, .vhdx, .vhd, .vdi or .qcow2"/>
          </DockPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Page 2: sysprep -->
      <ScrollViewer x:Name="Page1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock x:Name="TxtPrepTitle" Style="{StaticResource Title}" Text="Run sysprep on the reference machine"/>
          <CheckBox x:Name="ChkSysprepAtDeploy" Margin="0,0,0,10"
                    Content="Skip sysprep here: each PC runs sysprep at its first start (5-10 minutes more per PC, try it on one PC first)"/>
          <TextBlock x:Name="TxtPrepIntro" Style="{StaticResource Body}" Text="The tool cannot reach this machine's Windows by itself, so prepare it by hand. Run this in an elevated PowerShell window on the reference machine. It checks for a pending reboot and BitLocker, removes Store apps installed for a user only (they break sysprep; the Store stays), frees space, then runs sysprep and shuts the machine down."/>
          <DockPanel Margin="0,0,0,8">
            <Button x:Name="BtnCopyCmd" DockPanel.Dock="Right" Content="Copy"/>
            <TextBox x:Name="TxtPrepCmd" IsReadOnly="True" FontFamily="Consolas"/>
          </DockPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Page 3: check the disk (VM disk file only; the other choices skip it) -->
      <ScrollViewer x:Name="Page2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Style="{StaticResource Title}" Text="Check the disk"/>
          <TextBlock Style="{StaticResource Body}"
                     Text="The tool checks the VM's disk on this PC and reads the Windows on it before capturing. Nothing in the VM or its disk is changed. Next is available once every line has a tick."/>
          <ItemsControl x:Name="LstChecks">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Mark}" Foreground="{Binding Color}" FontWeight="Bold" FontSize="15"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource BodyBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ProgressBar x:Name="BarCheck" Height="8" Margin="26,6,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"
                       Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource TrackBrush}" BorderThickness="0"/>
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="BtnCheckAgain" Content="Check again" Margin="0"/>
            <Button x:Name="BtnCheckLog" Content="Open log" IsEnabled="False"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Page 4: image details -->
      <ScrollViewer x:Name="Page3" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Style="{StaticResource Title}" Text="Image details"/>
          <TextBlock x:Name="TxtDetailsIntro" Style="{StaticResource Body}" Text="Name the image and choose where to save it. An image with the same name is replaced once the capture succeeds; the old one is kept as an earlier version."/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition/><RowDefinition Height="10"/><RowDefinition/><RowDefinition Height="10"/><RowDefinition/>
              <RowDefinition Height="16"/><RowDefinition/><RowDefinition Height="4"/><RowDefinition/>
            </Grid.RowDefinitions>
            <Label Content="Name"/>
            <TextBox x:Name="TxtName" Grid.Column="1" ToolTip="Letters, digits, dot, dash and underscore. Becomes the file name."/>
            <Label Grid.Row="2" Content="Description"/>
            <TextBox x:Name="TxtDescription" Grid.Row="2" Grid.Column="1"/>
            <Label Grid.Row="4" Content="Compression"/>
            <ComboBox x:Name="CmbCompression" Grid.Row="4" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectedIndex="0">
              <ComboBoxItem Content="Maximum (smaller, slower)" Tag="max"/>
              <ComboBoxItem Content="Smallest (.esd, slowest capture)" Tag="recovery"
                            ToolTip="About a quarter smaller than Maximum, so a stick build copies less. The capture takes longer (it is compressed a second time) and each deploy a little longer."/>
            </ComboBox>
            <Label x:Name="LblSaveTo" Grid.Row="6" Content="Save to"/>
            <DockPanel x:Name="PnlSaveTo" Grid.Row="6" Grid.Column="1">
              <Button x:Name="BtnSaveToDefault" DockPanel.Dock="Right" Content="Default" Margin="6,0,0,0"
                      ToolTip="The Images folder of the content root"/>
              <Button x:Name="BtnSaveTo" DockPanel.Dock="Right" Content="Browse..."/>
              <TextBox x:Name="TxtSaveTo" ToolTip="A folder on this PC or a server share, like \\server\share\Images"/>
            </DockPanel>
            <TextBlock x:Name="TxtSaveToHint" Grid.Row="8" Grid.Column="1" Style="{StaticResource Body}" Margin="0"/>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- Page 5: summary -->
      <DockPanel x:Name="Page4" Visibility="Collapsed">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}" Text="Summary"/>
        <TextBlock x:Name="TxtSummaryIntro" DockPanel.Dock="Top" Style="{StaticResource Body}"
                   Text="Clicking Start shows the capture on top of the Images list, with each step and the time left. The copy of the disk made by the check is reused, so the capture starts right away. The new image takes its place in the list when it finishes."/>
        <TextBox x:Name="TxtSummary" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap"
                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SubtleBrush}"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
