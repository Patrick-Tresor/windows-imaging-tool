<!-- Form styles for the editor windows (answer file, application, task): spacing between fields, labels at the top
     of their row. A window takes them with <ResourceDictionary Source="FormStyles.xaml"/> in its resources;
     Read-ConsoleXaml (XamlWindow.psm1) copies these styles in its place. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Padding" Value="4,3"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Margin" Value="0,4,0,8"/>
  </Style>
  <Style TargetType="RadioButton">
    <Setter Property="Margin" Value="0,4,16,8"/>
  </Style>
  <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
    <Setter Property="Padding" Value="0,4,8,4"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
  </Style>
  <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="SelectionMode" Value="Single"/>
  </Style>
</ResourceDictionary>
