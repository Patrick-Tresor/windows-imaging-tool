<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imaging Console" Width="1100" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="#F4F5F7">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinWidth" Value="90"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0F6CBD"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#0F6CBD"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Label">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#E1E3E8"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="RowHeight" Value="26"/>
      <Setter Property="SelectionMode" Value="Single"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#5B6170"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Content root bar -->
    <Border DockPanel.Dock="Top" Background="#1F2937" Padding="16,10">
      <DockPanel>
        <TextBlock Text="Imaging Console" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
        <Label Content="Content root" Foreground="#CBD5E1"/>
        <Button x:Name="BtnInitRoot" DockPanel.Dock="Right" Content="Create folders" Margin="8,0,0,0"/>
        <Button x:Name="BtnBrowseRoot" DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"/>
        <TextBox x:Name="TxtRoot" IsReadOnly="True"/>
      </DockPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E1E3E8" BorderThickness="0,1,0,0" Padding="16,6">
      <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="#5B6170"/>
    </Border>

    <TabControl x:Name="Tabs" Margin="12" Padding="16" TabStripPlacement="Left" BorderThickness="0" Background="White">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Padding" Value="18,10"/>
          <Setter Property="MinWidth" Value="150"/>
          <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
      </TabControl.Resources>

      <!-- Images -->
      <TabItem Header="Images">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Golden images"/>
            <TextBlock Style="{StaticResource Hint}" Text="Images in the content root's Images folder. Click Capture new image to prepare a reference machine (ideally a VM) and capture it, or Update image to add the latest Windows updates to an image without capturing it again. Answer files choose which image a PC gets."/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnCapture" Content="Capture new image..." Style="{StaticResource Primary}"/>
            <Button x:Name="BtnImageVersions" Content="Versions..." ToolTip="Earlier versions of the selected image: keep a copy, roll back, delete old ones."/>
            <Button x:Name="BtnImageUpdate" Content="Update image..."/>
            <Button x:Name="BtnImagesRefresh" Content="Refresh"/>
            <Button x:Name="BtnImagesOpen" Content="Open folder"/>
          </StackPanel>
          <DataGrid x:Name="GridImages" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
              <DataGridTextColumn Header="Used by" Binding="{Binding UsedBy}" Width="2*"/>
              <DataGridTextColumn Header="Size (GB)" Binding="{Binding SizeGB}" Width="90"/>
              <DataGridTextColumn Header="Parts" Binding="{Binding Parts}" Width="60"/>
              <DataGridTextColumn Header="Earlier versions" Binding="{Binding Versions}" Width="110"/>
              <DataGridTextColumn Header="Modified" Binding="{Binding Modified, StringFormat=yyyy-MM-dd HH:mm}" Width="130"/>
              <DataGridTextColumn Header="Last updated" Binding="{Binding Updated}" Width="2*"/>
              <DataGridTextColumn Header="Editions (index: name)" Binding="{Binding Indexes}" Width="3*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- Driver library -->
      <TabItem Header="Driver Library">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <DockPanel MinHeight="440" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Style="{StaticResource SectionTitle}" Text="Driver library"/>
              <TextBlock Style="{StaticResource Hint}" Text="Each row maps a PC to a driver folder. The deploy matches SKU first, then Lenovo machine type, then exact model, then model pattern (wildcards allowed). Run Get-HardwareIdentity in WinPE to see a PC's values. Edit cells directly, then Save."/>
              <Grid Margin="0,4,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="220"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Find a model online:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtDriverFind" Grid.Column="1" VerticalContentAlignment="Center"
                         ToolTip="Type the PC model (Latitude 5521, EliteBook 840 G9, ThinkPad T14 Gen 4), a Dell or HP SKU or a Lenovo machine type, then press Enter or Search"/>
                <Button x:Name="BtnDriverFind" Grid.Column="3" Content="Search" Margin="6,0,0,0" IsDefault="False"
                        ToolTip="Searches the Dell, HP and Lenovo driver pack catalogs"/>
                <ComboBox x:Name="CmbDriverFound" Grid.Column="4" Margin="6,0,0,0" IsEnabled="False"
                          ToolTip="Driver packs found in the vendor catalogs: model, Windows version, release date and size"/>
                <Button x:Name="BtnDriverFoundDownload" Grid.Column="5" Content="Download" Margin="6,0,0,0" IsEnabled="False" Style="{StaticResource Primary}"
                        ToolTip="Downloads the pack from the vendor, checks it, extracts it to Drivers\Maker\Model and adds it to the library"/>
              </Grid>
            </StackPanel>

            <GroupBox DockPanel.Dock="Bottom" Header="Import a driver pack" Margin="0,12,0,0" Padding="10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
                <Label Content="Maker"/>
                <ComboBox x:Name="CmbMaker" Grid.Column="1" IsEditable="True">
                  <ComboBoxItem Content="Dell"/><ComboBoxItem Content="HP"/><ComboBoxItem Content="Lenovo"/>
                </ComboBox>
                <Label Grid.Column="2" Content="Model" Margin="8,0,0,0"/>
                <TextBox x:Name="TxtModel" Grid.Column="3"/>
                <Label Grid.Column="4" Content="SKU" Margin="8,0,0,0"/>
                <TextBox x:Name="TxtSku" Grid.Column="5"/>
                <Label Grid.Column="6" Content="Machine type" Margin="8,0,0,0"/>
                <TextBox x:Name="TxtMachineType" Grid.Column="7"/>

                <Label Grid.Row="2" Content="Source"/>
                <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="7">
                  <Button x:Name="BtnImport" DockPanel.Dock="Right" Content="Import" Style="{StaticResource Primary}" Margin="8,0,0,0"/>
                  <Button x:Name="BtnSrcFile" DockPanel.Dock="Right" Content="File..." Margin="8,0,0,0"/>
                  <Button x:Name="BtnSrcFolder" DockPanel.Dock="Right" Content="Folder..." Margin="8,0,0,0"/>
                  <TextBox x:Name="TxtSource" ToolTip="An extracted folder, a .cab (Dell, Lenovo) or a .zip"/>
                </DockPanel>
              </Grid>
            </GroupBox>

            <!-- Driver pack downloads run in the background; their progress stays here, under the library, until removed. -->
            <GroupBox x:Name="GrpDriverDownloads" DockPanel.Dock="Bottom" Header="Downloads" Margin="0,12,0,0" Padding="10,6" Visibility="Collapsed">
              <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="LstDriverDownloads">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,4,0,8">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Tag="remove" Content="Remove" Margin="6,0,0,0" Padding="10,2" MinWidth="70"
                                  IsEnabled="{Binding Finished}" ToolTip="Takes this finished download off the list"/>
                          <Button DockPanel.Dock="Right" Tag="log" Content="Open log" Margin="6,0,0,0" Padding="10,2" MinWidth="70"/>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Elapsed}" Foreground="#5B6170" VerticalAlignment="Center" Margin="8,0,0,0"/>
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock x:Name="DlSummary" Text="{Binding Summary}" Foreground="#5B6170" TextTrimming="CharacterEllipsis" Margin="0,2,0,2"/>
                        <ItemsControl ItemsSource="{Binding Steps}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*"/>
                                  <ColumnDefinition Width="190"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                  <RowDefinition Height="Auto"/>
                                  <RowDefinition Height="Auto"/>
                                  <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Grid.Column="0">
                                  <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Foreground="#3B3F48" Margin="8,0,0,0"/>
                                  <TextBlock x:Name="DlStepName" Text="{Binding Name}" Foreground="#1F2329" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <ProgressBar x:Name="DlBar" Grid.Row="1" Grid.Column="0" Height="8" Margin="0,4,0,0" Minimum="0" Maximum="100"
                                             Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate, Mode=OneWay}"
                                             Foreground="#0F6CBD" Background="#E8EAEE" BorderThickness="0"/>
                                <TextBlock x:Name="DlStatus" Grid.Row="1" Grid.Column="1" Text="{Binding Status}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" Foreground="#5B6170"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Detail}" Foreground="#5B6170" FontSize="12" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                              </Grid>
                              <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="pending">
                                  <Setter TargetName="DlStepName" Property="Foreground" Value="#8A8F99"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="done">
                                  <Setter TargetName="DlBar" Property="Foreground" Value="#2E9E5B"/>
                                  <Setter TargetName="DlStatus" Property="Foreground" Value="#2E9E5B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="failed">
                                  <Setter TargetName="DlBar" Property="Foreground" Value="#C4314B"/>
                                  <Setter TargetName="DlStatus" Property="Foreground" Value="#C4314B"/>
                                  <Setter TargetName="DlStatus" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                              </DataTemplate.Triggers>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Outcome}" Value="ok">
                          <Setter TargetName="DlSummary" Property="Foreground" Value="#2E9E5B"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Outcome}" Value="failed">
                          <Setter TargetName="DlSummary" Property="Foreground" Value="#C4314B"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </GroupBox>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
              <Button x:Name="BtnDriversSave" Content="Save" Style="{StaticResource Primary}"/>
              <Button x:Name="BtnDriversRemove" Content="Remove row"/>
              <Button x:Name="BtnDriversRefresh" Content="Refresh"/>
              <Button x:Name="BtnDriversOpen" Content="Open folder"/>
              <Button x:Name="BtnDriversDownload" Content="Download from vendor..." ToolTip="Pick Dell, HP or Lenovo models and download their driver packs from the vendor catalog"/>
              <Button x:Name="BtnDriversUnknown" Content="Unknown models..." ToolTip="Deployed PCs that got no driver pack, with the vendor pack for each model"/>
            </StackPanel>

            <DataGrid x:Name="GridDrivers" CanUserAddRows="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Maker" Binding="{Binding Maker}" Width="90"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="2*"/>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="70"/>
                <DataGridTextColumn Header="Machine type" Binding="{Binding MachineType}" Width="100"/>
                <DataGridTextColumn Header="Model pattern" Binding="{Binding ModelPattern}" Width="*"/>
                <DataGridTextColumn Header="Folder (under Drivers)" Binding="{Binding Path}" Width="2*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Media -->
      <TabItem x:Name="TabMedia" Header="Media">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="Build deployment media"/>
          <TextBlock Style="{StaticResource Hint}" Text="Builds WinPE with the deploy tool inside, using the settings from this content root. Needs the Windows ADK and the WinPE add-on on this PC. The build opens its own window and takes several minutes."/>

          <Border x:Name="BrdAdk" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,14">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnAdkDownload" Content="Download ADK" Margin="8,0,0,0"/>
                <Button x:Name="BtnAdkCheck" Content="Check again" Margin="8,0,0,0"/>
              </StackPanel>
              <TextBlock x:Name="TxtAdk" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>

          <RadioButton x:Name="RbUsb" GroupName="Media" Content="USB stick (offline: WinPE plus answer files, their images and drivers)" IsChecked="True" Margin="0,4"/>
          <RadioButton x:Name="RbIso" GroupName="Media" Content="ISO (boot from a VM or burn; content comes from the network share)" Margin="0,4"/>
          <RadioButton x:Name="RbPxe" GroupName="Media" Content="PXE boot.wim (publish to a WDS server; content comes from the network share)" Margin="0,4"/>

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>

            <Label Content="USB disk"/>
            <ComboBox x:Name="CmbUsb" Grid.Column="1" DisplayMemberPath="Label"/>
            <Button x:Name="BtnUsbRefresh" Grid.Column="2" Content="Refresh" Margin="8,0,0,0"/>

            <Label Grid.Row="2" Content="Copy content to USB" VerticalAlignment="Top"/>
            <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
              <CheckBox x:Name="ChkUsbUpdate" DockPanel.Dock="Top" Margin="0,0,0,8"
                        Content="Update a stick this console built before, without erasing it: new WinPE, and only the files that changed are copied"/>
              <CheckBox x:Name="ChkCopyContent" DockPanel.Dock="Top" IsChecked="True"
                        Content="The answer files checked below, the image each one deploys, drivers, applications and config (needed for offline use)"/>
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,6,0,4"
                         Text="An answer file names the image it deploys (Answer Files tab, Image page). Only the images of the checked answer files go on the stick. Click a line to check or uncheck it."/>
              <ListBox x:Name="LstMediaAnswers" SelectionMode="Multiple" MaxHeight="160" IsEnabled="{Binding IsChecked, ElementName=ChkCopyContent}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Label}" IsHitTestVisible="False" Focusable="False"
                              IsChecked="{Binding IsSelected, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <Label Grid.Row="4" Content="Driver packs on USB" VerticalAlignment="Top"/>
            <DockPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" IsEnabled="{Binding IsChecked, ElementName=ChkCopyContent}">
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,4"
                         Text="Check the packs for the models this stick will image. A PC whose pack is left off gets its maker's fallback pack if that is checked, otherwise Windows inbox drivers. Packs come from the Driver Library tab."/>
              <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                <Button x:Name="BtnMediaPacksAll" DockPanel.Dock="Left" Content="Check all"/>
                <Button x:Name="BtnMediaPacksNone" DockPanel.Dock="Left" Content="Uncheck all" Margin="8,0,0,0"/>
                <TextBlock x:Name="TxtMediaPacks" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </DockPanel>
              <ListBox x:Name="LstMediaPacks" SelectionMode="Multiple" MaxHeight="160">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Label}" IsHitTestVisible="False" Focusable="False"
                              IsChecked="{Binding IsSelected, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <Label Grid.Row="6" Content="Output folder (ISO/PXE)"/>
            <TextBox x:Name="TxtOutput" Grid.Row="6" Grid.Column="1"/>
            <Button x:Name="BtnOutput" Grid.Row="6" Grid.Column="2" Content="Browse..." Margin="8,0,0,0"/>

            <Label Grid.Row="8" Content="Extra WinPE drivers"/>
            <TextBox x:Name="TxtPeDrivers" Grid.Row="8" Grid.Column="1" ToolTip="Optional. NIC or storage drivers WinPE needs to see the disk or network on new hardware."/>
            <Button x:Name="BtnPeDrivers" Grid.Row="8" Grid.Column="2" Content="Browse..." Margin="8,0,0,0"/>

            <Label Grid.Row="10" Content="WinPE driver packs"/>
            <StackPanel Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2">
              <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="ChkPeDell" Content="Dell" IsChecked="True" Margin="0,0,16,0"/>
                <CheckBox x:Name="ChkPeHp" Content="HP" IsChecked="True"/>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,0"
                         Text="Storage and network drivers WinPE needs to see the disk and network (Intel RST/VMD). Downloaded once, then reused. Dell's Intel drivers also cover Lenovo and other PCs. Models with no driver pack get these drivers in Windows too. Each pack makes WinPE bigger and the build a few minutes longer."/>
            </StackPanel>

            <Label Grid.Row="12" Content="WinPE password" VerticalAlignment="Top"/>
            <StackPanel Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2">
              <StackPanel Orientation="Horizontal">
                <PasswordBox x:Name="PwdWinPE" Width="200"/>
                <TextBlock Text="Again" VerticalAlignment="Center" Margin="12,0,8,0"/>
                <PasswordBox x:Name="PwdWinPE2" Width="200"/>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,0"
                         Text="Recommended. WinPE asks for this one password when it starts, and nothing else: the join, local Administrator, share and other passwords go inside the boot image, encrypted with it. At least 8 characters. Leave empty and the deploy wizard has a Passwords page where the operator types each password the answer file needs, once, before Confirm. A locked PXE image waits for the WinPE password at every network boot."/>
            </StackPanel>

            <Label Grid.Row="14" Content="Passwords on USB"/>
            <CheckBox x:Name="ChkSecretsOnMedia" Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2" IsEnabled="{Binding IsChecked, ElementName=ChkCopyContent}"
                      Content="Also copy the password files (config\secrets) to the stick as plain text. Not needed: the answer files already carry their passwords encrypted. Not recommended: anyone with the stick can read them."/>

            <Label Grid.Row="16" Content="Online apps on USB"/>
            <CheckBox x:Name="ChkAppDownloads" Grid.Row="16" Grid.Column="1" Grid.ColumnSpan="2" IsChecked="True" IsEnabled="{Binding IsChecked, ElementName=ChkCopyContent}"
                      Content="Download the applications that install from the internet (Find an app online, Download tick box) onto the stick during the build, so PCs install them without internet. Reused for a week."/>
          </Grid>

          <GroupBox Header="PXE: Windows Deployment Services" Margin="0,16,0,0" Padding="8" IsEnabled="{Binding IsChecked, ElementName=RbPxe}">
            <StackPanel>
              <TextBlock Style="{StaticResource Hint}" Text="After the build, boot.wim is published to the WDS server and becomes the default UEFI network boot entry. Publishing again replaces it. Leave the server empty to use this PC. A remote server must allow PowerShell remoting and you must be an administrator on it."/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>

                <Label Content="Publish to WDS"/>
                <CheckBox x:Name="ChkWdsPublish" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Content="Publish boot.wim to the WDS server after building"/>

                <Label Grid.Row="2" Content="WDS server"/>
                <TextBox x:Name="TxtWdsServer" Grid.Row="2" Grid.Column="1" ToolTip="Server name, for example wds01. Empty: this PC."/>
                <Button x:Name="BtnWdsCheck" Grid.Row="2" Grid.Column="2" Content="Check server" Margin="8,0,0,0"/>

                <Label Grid.Row="4" Content="Boot menu name"/>
                <TextBox x:Name="TxtWdsImageName" Grid.Row="4" Grid.Column="1" ToolTip="Shown in the PXE boot menu. An image with this name is replaced."/>

                <Label Grid.Row="6" Content="Set up WDS"/>
                <CheckBox x:Name="ChkWdsSetup" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center"
                          Content="Install and configure WDS if needed (standalone, answers all PXE clients)"/>

                <Label Grid.Row="8" Content="RemoteInstall folder"/>
                <TextBox x:Name="TxtWdsRemInst" Grid.Row="8" Grid.Column="1" IsEnabled="{Binding IsChecked, ElementName=ChkWdsSetup}"
                         ToolTip="On the WDS server. Used only when WDS is configured for the first time. Not the system drive."/>

                <Label Grid.Row="10" Content="Options"/>
                <StackPanel Grid.Row="10" Grid.Column="1">
                  <CheckBox x:Name="ChkWdsDhcp" Content="DHCP runs on the WDS server too" Margin="0,2"/>
                  <CheckBox x:Name="ChkWdsNoPrompt" Content="Boot without pressing F12 or Enter (any PC set to network boot starts the deploy)" Margin="0,2"/>
                </StackPanel>
              </Grid>
              <TextBox x:Name="TxtWdsStatus" Height="80" Margin="0,10,0,0" IsReadOnly="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            </StackPanel>
          </GroupBox>

          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button x:Name="BtnBuild" Content="Build media" Style="{StaticResource Primary}"/>
          </StackPanel>
          <!-- The tool never changes Defender's settings itself: the admin adds these folders once. -->
          <Border x:Name="BdrScanTip" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,8" Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <TextBlock x:Name="TxtScanTip" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="BtnScanTipOpen" Content="Open Windows Security"/>
                <Button x:Name="BtnScanTipCopy" Content="Copy the folders" Margin="8,0,0,0"/>
                <Button x:Name="BtnScanTipDone" Content="Done, hide this" Margin="8,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Answer files -->
      <TabItem Header="Answer Files">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Answer files"/>
            <TextBlock Style="{StaticResource Hint}" Text="An answer file is one deployment profile: image, applications, disk, regional settings, computer naming, domain join, tasks and shares. The PC picks one at boot (or uses the default). Passwords are saved in the answer file, encrypted; the key stays in config\secrets."/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnAnswerNew" Content="New..." Style="{StaticResource Primary}"/>
            <Button x:Name="BtnAnswerImport" Content="Import answer file XML..."/>
            <Button x:Name="BtnAnswerEdit" Content="Edit"/>
            <Button x:Name="BtnAnswerDefault" Content="Set as default"/>
            <Button x:Name="BtnAnswerRefresh" Content="Refresh"/>
            <Button x:Name="BtnAnswerOpen" Content="Open folder"/>
          </StackPanel>
          <TextBox x:Name="TxtAnswerIssues" DockPanel.Dock="Bottom" Height="90" Margin="0,10,0,0" IsReadOnly="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Foreground="#B91C1C"/>
          <DataGrid x:Name="GridAnswers" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Default" Binding="{Binding IsDefault}" Width="65"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
              <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="90"/>
              <DataGridTextColumn Header="Image" Binding="{Binding Image}" Width="2*"/>
              <DataGridTextColumn Header="Apps" Binding="{Binding Apps}" Width="50"/>
              <DataGridTextColumn Header="Joins" Binding="{Binding Joins}" Width="*"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- Applications -->
      <TabItem Header="Applications">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Applications"/>
            <TextBlock Style="{StaticResource Hint}" Text="Application packs: an installer with its silent command, detection rules and the PCs it is for. Answer files pick which ones to install at first boot. Export a pack to a .zip to copy it to another content root."/>
          </StackPanel>
          <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnAppNew" Content="New..." Style="{StaticResource Primary}"/>
            <Button x:Name="BtnAppEdit" Content="Edit"/>
            <Button x:Name="BtnAppTest" Content="Test detection"/>
            <Button x:Name="BtnAppExport" Content="Export..."/>
            <Button x:Name="BtnAppImport" Content="Import..."/>
            <Button x:Name="BtnAppDelete" Content="Delete"/>
            <Button x:Name="BtnAppsRefresh" Content="Refresh"/>
            <Button x:Name="BtnAppsOpen" Content="Open folder"/>
          </WrapPanel>
          <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Find an app online:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtAppFind" Grid.Column="1" VerticalContentAlignment="Center"
                     ToolTip="Type the application's name (VLC, 7-Zip, Notepad++, Adobe Reader...) and press Enter or Search"/>
            <Button x:Name="BtnAppFind" Grid.Column="2" Content="Search" Margin="6,0,0,0" IsDefault="False"/>
            <ComboBox x:Name="CmbAppFound" Grid.Column="3" Margin="6,0,0,0" IsEnabled="False"
                      ToolTip="Results from Microsoft's winget catalog: name, id and latest version"/>
            <Button x:Name="BtnAppFoundAdd" Grid.Column="4" Content="Add" Margin="6,0,0,0" IsEnabled="False" Style="{StaticResource Primary}"
                    ToolTip="Adds the application: the PC downloads it from the publisher when it installs it and checks the file's SHA256"/>
          </Grid>
          <TextBox x:Name="TxtAppIssues" DockPanel.Dock="Bottom" Height="90" Margin="0,10,0,0" IsReadOnly="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <CheckBox x:Name="ChkAppOnline" IsEnabled="False" Content="Download it from the internet when the PC installs it (no installer to keep in the pack)"
                      ToolTip="Uses the publisher's link the console already knows for this application. Untick to use the installer in the pack again."/>
            <TextBlock x:Name="TxtAppOnline" Foreground="#5B6170" TextWrapping="Wrap" Margin="22,2,0,0"/>
          </StackPanel>
          <DataGrid x:Name="GridApps" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
              <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90"/>
              <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
              <DataGridTextColumn Header="For" Binding="{Binding For}" Width="*"/>
              <DataGridTextColumn Header="Detection" Binding="{Binding Detection}" Width="2*"/>
              <DataGridTextColumn Header="Download link" Binding="{Binding Download}" Width="2*"/>
              <DataGridTextColumn Header="Used by" Binding="{Binding UsedBy}" Width="*"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- Tasks -->
      <TabItem Header="Tasks">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Tasks"/>
            <TextBlock Style="{StaticResource Hint}" Text="Scripts to run during or after a deployment: PowerShell (.ps1), batch (.cmd, .bat) or a program (.exe), with its arguments, timeout, success exit codes and the PCs it is for. Write the script here or import a file or folder. Answer files pick which tasks run (Tasks page), in order with their other commands. POSTIMAGE and FIRSTBOOT runs are logged in C:\Windows\Temp\Task-&lt;name&gt;.log on the PC, next to Deploy.log and FirstBoot.log."/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnTaskNew" Content="New..." Style="{StaticResource Primary}"/>
            <Button x:Name="BtnTaskEdit" Content="Edit"/>
            <Button x:Name="BtnTaskExport" Content="Export..."/>
            <Button x:Name="BtnTaskImport" Content="Import..."/>
            <Button x:Name="BtnTaskDelete" Content="Delete"/>
            <Button x:Name="BtnTasksRefresh" Content="Refresh"/>
            <Button x:Name="BtnTasksOpen" Content="Open folder"/>
          </StackPanel>
          <TextBox x:Name="TxtTaskIssues" DockPanel.Dock="Bottom" Height="90" Margin="0,10,0,0" IsReadOnly="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
          <DataGrid x:Name="GridTaskLibrary" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Script" Binding="{Binding Script}" Width="*"/>
              <DataGridTextColumn Header="Runs" Binding="{Binding Phase}" Width="100"/>
              <DataGridTextColumn Header="For" Binding="{Binding For}" Width="*"/>
              <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
              <DataGridTextColumn Header="Used by" Binding="{Binding UsedBy}" Width="*"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- Naming list -->
      <TabItem Header="Naming List">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Naming list"/>
            <TextBlock Style="{StaticResource Hint}" Text="One row per PC, matched by BIOS serial number at deploy time. A listed PC gets its computer name, OU and answer file from here; an empty cell keeps the answer file's setting (or the default answer file). Saved to config\naming-list.csv, which you can also edit in Excel. Edit cells directly, then Save."/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnNamingSave" Content="Save" Style="{StaticResource Primary}"/>
            <Button x:Name="BtnNamingImport" Content="Import CSV..."/>
            <Button x:Name="BtnNamingExport" Content="Export CSV..."/>
            <Button x:Name="BtnNamingRemove" Content="Remove row"/>
            <Button x:Name="BtnNamingRefresh" Content="Refresh"/>
            <Button x:Name="BtnNamingOpen" Content="Open folder"/>
          </StackPanel>
          <TextBox x:Name="TxtNamingIssues" DockPanel.Dock="Bottom" Height="70" Margin="0,10,0,0" IsReadOnly="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Foreground="#B91C1C"/>
          <DataGrid x:Name="GridNaming" CanUserAddRows="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="130"/>
              <DataGridTextColumn Header="Computer name" Binding="{Binding ComputerName}" Width="130"/>
              <DataGridTextColumn Header="OU" Binding="{Binding OU}" Width="3*"/>
              <DataGridComboBoxColumn Header="Answer file" SelectedItemBinding="{Binding AnswerFile}" Width="150"/>
              <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
              <DataGridTextColumn Header="Last deploy" Binding="{Binding LastDeploy}" Width="140" IsReadOnly="True"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- Settings -->
      <TabItem x:Name="TabSettings" Header="Deploy Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel.Resources>
              <Style x:Key="SettingsHead" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,18,0,4"/>
              </Style>
            </StackPanel.Resources>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Deploy settings"/>
            <TextBlock Style="{StaticResource Hint}" Text="How PCs reach the deployment, where they report, and what they check at the end. Everything else about a deployment is in the answer files."/>

            <!-- 1. Where the deployment comes from -->
            <TextBlock Style="{StaticResource SettingsHead}" Text="1. Where PCs get the deployment"/>
            <RadioButton x:Name="RbSettingsUsb" GroupName="SettingsMode" Margin="0,4"
                         Content="USB stick only. Everything is on the stick; no network needed."/>
            <RadioButton x:Name="RbSettingsShare" GroupName="SettingsMode" Margin="0,4"
                         Content="Network share. Needed for ISO and PXE boot. A USB stick still deploys from the stick first."/>
            <Grid x:Name="PnlSharePath" Margin="22,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Label Content="Share"/>
              <TextBox x:Name="TxtSharePath" Grid.Column="1" ToolTip="The content root on your server, for example \\SERVER01\Deploy."/>
            </Grid>

            <!-- 2. The account -->
            <StackPanel x:Name="PnlShareAccount">
              <TextBlock Style="{StaticResource SettingsHead}" Text="2. Account WinPE signs in with"/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="An Active Directory account that can read the share (and write to its Status folder). Leave it empty if the share allows guests. The password is saved encrypted (AES-256) in deploy-settings.json, like the answer files' passwords: there is no password file."/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
                <Label Content="Account"/>
                <TextBox x:Name="TxtShareUser" Grid.Column="1" Width="320" HorizontalAlignment="Left" ToolTip="CORP\svc-deploy or svc-deploy@corp.example.com"/>
                <Label Grid.Row="2" Content="Password"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                  <PasswordBox x:Name="PwdShare" Width="320" Padding="4,3" VerticalContentAlignment="Center"/>
                  <TextBlock x:Name="TxtSharePwState" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#5B6170"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="BtnShareTest" Content="Test connection"/>
                  <TextBlock x:Name="TxtShareTest" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="560"/>
                </StackPanel>
              </Grid>
            </StackPanel>

            <!-- 3. Dashboard -->
            <TextBlock Style="{StaticResource SettingsHead}" Text="3. Where PCs report progress (Dashboard)"/>
            <RadioButton x:Name="RbReportDefault" GroupName="SettingsReport" Margin="0,4"
                         Content="Same place as the deployment: the share's Status folder, or the stick's for USB deploys."/>
            <RadioButton x:Name="RbReportShare" GroupName="SettingsReport" Margin="0,4"
                         Content="A network folder, so USB deploys show up live too:"/>
            <Grid Margin="22,6,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Label Content="Status folder"/>
              <TextBox x:Name="TxtReportPath" Grid.Column="1" ToolTip="For example \\SERVER01\Deploy\Status. WinPE maps it with the account above."/>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="After the restart, Windows reports as the computer account: give Domain Computers Modify on the Status folder, or the PC shows Stalled after first boot."/>

            <!-- 4. Deployments -->
            <TextBlock Style="{StaticResource SettingsHead}" Text="4. Deployments"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
              <Label Content="Default answer file"/>
              <ComboBox x:Name="CmbDefaultAnswer" Grid.Column="1" Width="320" HorizontalAlignment="Left" ToolTip="Used when nothing else picks one (naming list, the wizard)."/>
              <Label Grid.Row="2" Content="Older image versions to keep"/>
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="TxtVersionsToKeep" Width="80"
                         ToolTip="Keep the newest N earlier versions of each image; older ones are deleted after a copy or rollback. Versions an answer file is pinned to are never deleted."/>
                <TextBlock Text="0 keeps all of them" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#5B6170"/>
              </StackPanel>
            </Grid>

            <!-- 5. Checks -->
            <TextBlock Style="{StaticResource SettingsHead}" Text="5. Checks after deploy"/>
            <CheckBox x:Name="ChkChecksEnabled" Margin="0,4,0,8" VerticalAlignment="Center"
                      Content="At the end of first boot, check the name, domain join, device drivers, applications and BitLocker, and show pass or fail on the Dashboard"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
              <Label Content="BitLocker check"/>
              <ComboBox x:Name="CmbCheckBitLocker" Grid.Column="1" Width="320" HorizontalAlignment="Left"
                        ToolTip="Auto: required when the answer file turns BitLocker on, otherwise only reported. Report: a warning, never a failure.">
                <ComboBoxItem Content="Auto"/><ComboBoxItem Content="Required"/><ComboBoxItem Content="Report"/><ComboBoxItem Content="Off"/>
              </ComboBox>
              <Label Grid.Row="2" Content="Device driver check"/>
              <ComboBox x:Name="CmbCheckDevices" Grid.Row="2" Grid.Column="1" Width="320" HorizontalAlignment="Left"
                        ToolTip="Any device with an error in Device Manager (no driver, cannot start). Disabled devices are ignored.">
                <ComboBoxItem Content="Required"/><ComboBoxItem Content="Report"/><ComboBoxItem Content="Off"/>
              </ComboBox>
              <Label Grid.Row="4" Content="Ignore devices"/>
              <TextBox x:Name="TxtCheckIgnore" Grid.Row="4" Grid.Column="1"
                       ToolTip="Device names or ids to leave out of the driver check, separated by semicolons. Wildcards work, for example *Smart Card*; PCI\VEN_8086&amp;DEV_9D3A*"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
              <Button x:Name="BtnSettingsSave" Content="Save" Style="{StaticResource Primary}"/>
              <TextBlock x:Name="TxtSettingsProblem" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#B91C1C" TextWrapping="Wrap" MaxWidth="700"/>
            </StackPanel>
            <Border x:Name="BdrSettingsStale" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,8" Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4">
              <DockPanel>
                <Button x:Name="BtnSettingsMedia" DockPanel.Dock="Right" Content="Open the Media tab" Margin="12,0,0,0"/>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Saved. WinPE reads these settings from the boot image, so update or rebuild your USB sticks (and republish PXE) before the next deploy."/>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Computers in Active Directory -->
      <TabItem x:Name="TabComputers" Header="Computers">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <DockPanel MinHeight="520" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Style="{StaticResource SectionTitle}" Text="Computers in Active Directory"/>
              <TextBlock Style="{StaticResource Hint}" Text="Lists the computers in your domain, or in one OU. Select PCs that are on and click Reimage: each one gets WinPE from the network boot image, restarts into it and deploys the answer file without anyone at the PC, keeping its name and OU. Progress then shows on the Dashboard. The PCs need PowerShell remoting (WinRM) on, with your account as administrator; the image comes from the network share on the Deploy Settings tab."/>
            </StackPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <Label Content="Domain"/>
              <TextBox x:Name="TxtAdDomain" Width="170" Margin="0,0,12,0" ToolTip="For example corp.local. Empty = the domain this PC is joined to."/>
              <Label Content="Domain controller"/>
              <TextBox x:Name="TxtAdServer" Width="150" Margin="0,0,12,0" ToolTip="Optional. Needed only when this PC is not joined to the domain, e.g. dc01.corp.local."/>
              <CheckBox x:Name="ChkAdUseShare" VerticalAlignment="Center" Margin="0,0,12,0" Content="Use the Deploy Settings account"
                        ToolTip="The account and saved password from the Deploy Settings tab, so nothing is typed twice. Untick it to use another account (an administrator on the PCs)."/>
              <Label Content="Account"/>
              <TextBox x:Name="TxtAdUser" Width="150" Margin="0,0,12,0" ToolTip="CORP\admin, or empty for the account you are signed in with. Its password is asked once and not saved."/>
              <Button x:Name="BtnAdConnect" Content="Connect" Style="{StaticResource Primary}"/>
            </WrapPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <Label Content="OU"/>
              <ComboBox x:Name="CmbAdOu" Width="240" Margin="0,0,12,0" DisplayMemberPath="Path" ToolTip="The OU to list, with the OUs under it."/>
              <Label Content="Name"/>
              <TextBox x:Name="TxtAdName" Width="110" Margin="0,0,12,0" ToolTip="Part of a name (LAB) or a pattern (LAB-*). Empty = all."/>
              <CheckBox x:Name="ChkAdServers" Content="Servers" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <CheckBox x:Name="ChkAdDisabled" Content="Disabled accounts" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Button x:Name="BtnAdSearch" Content="Search"/>
              <Button x:Name="BtnAdOnline" Content="Check online" ToolTip="Which PCs answer on PowerShell remoting (WinRM) now."/>
            </WrapPanel>
            <GroupBox DockPanel.Dock="Bottom" Header="Reimage the selected PCs" Padding="8" Margin="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="6"/><RowDefinition/><RowDefinition Height="6"/><RowDefinition/><RowDefinition Height="10"/><RowDefinition/></Grid.RowDefinitions>
                <Label Content="Answer file"/>
                <ComboBox x:Name="CmbAdAnswer" Grid.Column="1" Width="260" HorizontalAlignment="Left"/>
                <WrapPanel Grid.Row="2" Grid.ColumnSpan="2">
                  <CheckBox x:Name="ChkAdKeepName" IsChecked="True" Margin="0,0,16,0" Content="Keep each PC's name"/>
                  <CheckBox x:Name="ChkAdKeepOu" IsChecked="True" Content="Join it back into its OU"/>
                </WrapPanel>
                <DockPanel Grid.Row="4" Grid.ColumnSpan="2">
                  <Button x:Name="BtnAdBuildBoot" DockPanel.Dock="Right" Content="Build network boot image" Margin="8,0,0,0"
                          ToolTip="Builds WinPE with the deploy tool, without a WinPE password, into Boot on the content root. Rebuild it after updating the tool or the share settings."/>
                  <TextBlock x:Name="TxtAdBoot" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#5B6170"/>
                </DockPanel>
                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal">
                  <Button x:Name="BtnAdReimage" Content="Reimage..." Style="{StaticResource Primary}"/>
                  <Button x:Name="BtnAdCancel" Content="Cancel reimage" ToolTip="Removes the waiting job of the selected PCs. A PC whose deploy has started is not stopped."/>
                </StackPanel>
              </Grid>
            </GroupBox>
            <DataGrid x:Name="GridAd" IsReadOnly="True" SelectionMode="Extended">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                <DataGridTextColumn Header="OU" Binding="{Binding OUPath}" Width="*"/>
                <DataGridTextColumn Header="Operating system" Binding="{Binding OperatingSystem}" Width="*"/>
                <DataGridTextColumn Header="Last logon" Binding="{Binding LastLogonText}" Width="85"/>
                <DataGridTextColumn Header="Online" Binding="{Binding Online}" Width="55"/>
                <DataGridTextColumn Header="Reimage" Binding="{Binding Reimage}" Width="*"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Dashboard -->
      <TabItem x:Name="TabDashboard" Header="Dashboard">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <DockPanel MinHeight="480" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Style="{StaticResource SectionTitle}" Text="Deployment dashboard"/>
              <TextBlock Style="{StaticResource Hint}" Text="Each PC reports its progress while it deploys: from WinPE to the Status folder, then from Windows at first boot while applications install. At the end of first boot it runs the post-deploy checks; the Checks column shows the result, and the details below show each check. A PC that stops reporting is shown as Stalled. First boot reports as the computer account, so the status share must let Domain Computers write to it."/>
              <UniformGrid Rows="1" Margin="0,0,0,12">
                <UniformGrid.Resources>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#E1E3E8"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="Margin" Value="0,0,8,0"/>
                  </Style>
                </UniformGrid.Resources>
                <Border><StackPanel><TextBlock x:Name="TxtDashRunning" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#0F6CBD"/><TextBlock Text="Deploying" Foreground="#5B6170"/></StackPanel></Border>
                <Border><StackPanel><TextBlock x:Name="TxtDashSucceeded" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#15803D"/><TextBlock Text="Succeeded" Foreground="#5B6170"/></StackPanel></Border>
                <Border><StackPanel><TextBlock x:Name="TxtDashWarning" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#B45309"/><TextBlock Text="With warnings" Foreground="#5B6170"/></StackPanel></Border>
                <Border><StackPanel><TextBlock x:Name="TxtDashFailed" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#B91C1C"/><TextBlock Text="Failed or stalled" Foreground="#5B6170"/></StackPanel></Border>
                <Border Margin="0"><StackPanel><TextBlock x:Name="TxtDashTotal" Text="0" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="PCs listed" Foreground="#5B6170"/></StackPanel></Border>
              </UniformGrid>
            </StackPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <Button x:Name="BtnDashRefresh" Content="Refresh"/>
              <CheckBox x:Name="ChkDashAuto" Content="Refresh every 10 s" IsChecked="True" VerticalAlignment="Center" Margin="4,0,16,0"/>
              <Label Content="Show"/>
              <ComboBox x:Name="CmbDashFilter" Width="150" SelectedIndex="0" VerticalContentAlignment="Center">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="Deploying"/>
                <ComboBoxItem Content="Failed or stalled"/>
                <ComboBoxItem Content="Finished"/>
              </ComboBox>
              <Button x:Name="BtnDashOpen" DockPanel.Dock="Right" Content="Open folder" Margin="8,0,0,0"/>
              <Button x:Name="BtnDashClear" DockPanel.Dock="Right" Content="Clear finished" Margin="8,0,0,0"/>
              <Button x:Name="BtnDashRemove" DockPanel.Dock="Right" Content="Remove" Margin="8,0,0,0"/>
              <TextBlock/>
            </DockPanel>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="120"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="220" MinHeight="80"/></Grid.RowDefinitions>
              <DataGrid x:Name="GridDash" IsReadOnly="True">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Background" Value="#FEF2F2"/></DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Stalled"><Setter Property="Background" Value="#FEF2F2"/></DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Warning"><Setter Property="Background" Value="#FFFBEB"/></DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Succeeded"><Setter Property="Background" Value="#F0FDF4"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Computer" Binding="{Binding ComputerName}" Width="120"/>
                  <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
                  <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="100"/>
                  <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="100"/>
                  <DataGridTextColumn Header="Answer file" Binding="{Binding AnswerFile}" Width="110"/>
                  <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80"/>
                  <DataGridTemplateColumn Header="Progress" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Grid Margin="2,4">
                          <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100"/>
                          <TextBlock Text="{Binding Percent, StringFormat={}{0} %}" HorizontalAlignment="Center" FontSize="11"/>
                        </Grid>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Step" Binding="{Binding Step}" Width="2*"/>
                  <DataGridTextColumn Header="Checks" Binding="{Binding Checks}" Width="1.5*">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="ToolTip" Value="{Binding Checks}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CheckResult}" Value="Failed"><Setter Property="Foreground" Value="#B91C1C"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                          <DataTrigger Binding="{Binding CheckResult}" Value="Warning"><Setter Property="Foreground" Value="#B45309"/></DataTrigger>
                          <DataTrigger Binding="{Binding CheckResult}" Value="Passed"><Setter Property="Foreground" Value="#15803D"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Started" Binding="{Binding Started, StringFormat=MM-dd HH:mm}" Width="85"/>
                  <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="70"/>
                  <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="70"/>
                </DataGrid.Columns>
              </DataGrid>
              <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent"/>
              <TextBlock x:Name="TxtDashDetail" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#374151"/>
              <TextBox x:Name="TxtDashLog" Grid.Row="3" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" VerticalContentAlignment="Top"/>
            </Grid>
          </DockPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Logs -->
      <TabItem Header="Deployment Logs">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Deployment logs"/>
            <TextBlock Style="{StaticResource Hint}" Text="One log per deployed PC, written to the content root's Logs folder when the deploy finishes or fails."/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnLogsRefresh" Content="Refresh"/>
          </StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="GridLogs" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="When" Binding="{Binding When, StringFormat=yyyy-MM-dd HH:mm}" Width="130"/>
                <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="*"/>
                <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="70"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBox x:Name="TxtLog" Grid.Column="2" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" VerticalContentAlignment="Top"/>
          </Grid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
