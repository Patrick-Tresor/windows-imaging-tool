<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imaging Console" Width="1100" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
      <Setter Property="SelectionMode" Value="Single"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Content root bar -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}" Padding="18,12">
      <DockPanel>
        <Image x:Name="ImgLogo" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="Imaging Console" Foreground="White" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock x:Name="TxtToolVersion" Foreground="{DynamicResource SidebarTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,3,28,0"/>
        <Label Content="Content root" Foreground="{DynamicResource SidebarTextBrush}"/>
        <!-- Shown while a progress window exists (build, capture, reimage), also one that was closed: shows them again. -->
        <Button x:Name="BtnShowProgress" DockPanel.Dock="Right" Content="Show progress" Margin="20,0,0,0" Visibility="Collapsed"
                ToolTip="Opens the progress windows again, also the ones you closed while the work goes on."/>
        <Button x:Name="BtnOpenRoot" DockPanel.Dock="Right" Content="Open folder" Margin="8,0,0,0" ToolTip="Opens the content root in File Explorer"/>
        <Button x:Name="BtnBrowseRoot" DockPanel.Dock="Right" Content="Browse..." Margin="8,0,0,0"/>
        <TextBox x:Name="TxtRoot" IsReadOnly="True"/>
      </DockPanel>
    </Border>

    <!-- Shown when a USB stick plugged into this PC, or the network boot image, was built with an older version of the tool. -->
    <Border x:Name="BdrStickOld" DockPanel.Dock="Top" Visibility="Collapsed" Padding="18,8" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningLineBrush}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnStickOldUpdate" Content="Update the stick" Margin="12,0,0,0"/>
          <Button x:Name="BtnBootOldRebuild" Content="Rebuild network boot image" Margin="8,0,0,0" Visibility="Collapsed"/>
          <Button x:Name="BtnStickOldHide" Content="Not now" Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="TxtStickOld" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,7">
      <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{DynamicResource MutedBrush}"/>
    </Border>

    <TabControl x:Name="Tabs" Margin="14" Padding="20" TabStripPlacement="Left" Style="{StaticResource NavTabs}">
      <TabControl.Resources>
        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
          <Setter Property="MinWidth" Value="150"/>
          <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
      </TabControl.Resources>

      <!-- Images -->
      <TabItem x:Name="TabImages" Header="Images">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Golden images"/>
            <TextBlock Style="{StaticResource Hint}" Text="Images in the content root's Images folder. Click Capture new image to prepare a reference machine (ideally a VM) and capture it, or Update image to add the latest Windows updates to an image without capturing it again. Answer files choose which image a PC gets."/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnCapture" Content="Capture new image..." Style="{StaticResource Primary}"/>
            <Button x:Name="BtnImageVersions" Content="Versions..." ToolTip="Earlier versions of the selected image: keep a copy, roll back, delete old ones."/>
            <Button x:Name="BtnImageUpdate" Content="Update image..."/>
            <Button x:Name="BtnImageLog" Content="Open log" ToolTip="The newest capture or update log of the selected image."/>
          </StackPanel>
          <DataGrid x:Name="GridImages" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
              <DataGridTextColumn Header="Used by" Binding="{Binding UsedBy}" Width="2*"/>
              <DataGridTextColumn Header="Size (GB)" Binding="{Binding SizeGB}" Width="90"/>
              <DataGridTextColumn Header="Parts" Binding="{Binding Parts}" Width="60"/>
              <DataGridTextColumn Header="Earlier versions" Binding="{Binding Versions}" Width="110"/>
              <DataGridTextColumn Header="Modified" Binding="{Binding Modified, StringFormat=yyyy-MM-dd HH:mm}" Width="130"/>
              <DataGridTextColumn Header="Last updated" Binding="{Binding Updated}" Width="2*"/>
              <DataGridTextColumn Header="Editions (index: name)" Binding="{Binding Indexes}" Width="3*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- Driver library -->
      <TabItem x:Name="TabDrivers" Header="Driver Library">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <DockPanel MinHeight="440" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Style="{StaticResource SectionTitle}" Text="Driver library"/>
              <TextBlock Style="{StaticResource Hint}" Text="Each row maps a PC to a driver folder. The deploy matches SKU first, then Lenovo machine type, then exact model, then model pattern (wildcards allowed). Run Get-HardwareIdentity in WinPE to see a PC's values. Edit cells directly, then Save."/>
              <Grid Margin="0,4,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="220"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Find a model online:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtDriverFind" Grid.Column="1" VerticalContentAlignment="Center"
                         ToolTip="Type the PC model (Latitude 5521, EliteBook 840 G9, ThinkPad T14 Gen 4), a Dell or HP SKU or a Lenovo machine type, then press Enter or Search"/>
                <Button x:Name="BtnDriverFind" Grid.Column="3" Content="Search" Margin="6,0,0,0" IsDefault="False"
                        ToolTip="Searches the Dell, HP and Lenovo driver pack catalogs"/>
                <ComboBox x:Name="CmbDriverFound" Grid.Column="4" Margin="6,0,0,0" IsEnabled="False"
                          ToolTip="Driver packs found in the vendor catalogs: model, Windows version, release date and size"/>
                <Button x:Name="BtnDriverFoundDownload" Grid.Column="5" Content="Download" Margin="6,0,0,0" IsEnabled="False" Style="{StaticResource Primary}"
                        ToolTip="Downloads the pack from the vendor, checks it, extracts it to Drivers\Maker\Model and adds it to the library"/>
              </Grid>
              <!-- Models deployed without their driver pack (from the Dashboard's status records). Hidden when there are none. -->
              <Border x:Name="BdrUnknown" Visibility="Collapsed" Margin="0,0,0,10" Padding="12,8" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningLineBrush}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                  <TextBlock x:Name="TxtUnknown" DockPanel.Dock="Top" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                  <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Top">
                    <Button x:Name="BtnUnknownFind" Content="Find its pack" Margin="0,0,0,6"
                            ToolTip="Looks up the selected model's pack in its maker's catalog (by SKU or machine type first) and puts it in the box above, ready to Download"/>
                    <Button x:Name="BtnUnknownInbox" Content="No pack needed" Margin="0"
                            ToolTip="For the selected models (a VM, say): a catalog entry with no folder, so they leave this list and deploy with Windows inbox drivers without a warning"/>
                  </StackPanel>
                  <DataGrid x:Name="GridUnknown" IsReadOnly="True" MaxHeight="150" SelectionMode="Extended">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Maker" Binding="{Binding Maker}" Width="80"/>
                      <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="2*"/>
                      <DataGridTextColumn Header="SKU / type" Binding="{Binding Ids}" Width="90"/>
                      <DataGridTextColumn Header="PCs" Binding="{Binding PCs}" Width="45"/>
                      <DataGridTextColumn Header="Computers" Binding="{Binding Computers}" Width="*"/>
                      <DataGridTextColumn Header="Got" Binding="{Binding Drivers}" Width="110"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </DockPanel>
              </Border>
            </StackPanel>

            <GroupBox DockPanel.Dock="Bottom" Header="Import a driver pack" Margin="0,12,0,0" Padding="10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
                <Label Content="Model"/>
                <TextBox x:Name="TxtModel" Grid.Column="1" Grid.ColumnSpan="3" ToolTip="For example Latitude 5521 or HP EliteBook 840 G8. The maker is read from the model or the pack's name."/>
                <Label Grid.Column="4" Content="SKU" Margin="8,0,0,0"/>
                <TextBox x:Name="TxtSku" Grid.Column="5"/>
                <Label Grid.Column="6" Content="Machine type" Margin="8,0,0,0"/>
                <TextBox x:Name="TxtMachineType" Grid.Column="7"/>

                <Label Grid.Row="2" Content="Source"/>
                <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="7">
                  <Button x:Name="BtnImport" DockPanel.Dock="Right" Content="Import" Style="{StaticResource Primary}" Margin="8,0,0,0"/>
                  <Button x:Name="BtnSrcFile" DockPanel.Dock="Right" Content="File..." Margin="8,0,0,0"/>
                  <Button x:Name="BtnSrcFolder" DockPanel.Dock="Right" Content="Folder..." Margin="8,0,0,0"/>
                  <TextBox x:Name="TxtSource" ToolTip="An extracted folder, a .cab (Dell, Lenovo) or a .zip"/>
                </DockPanel>
              </Grid>
            </GroupBox>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
              <Button x:Name="BtnDriversSave" Content="Save" Style="{StaticResource Primary}"/>
              <Button x:Name="BtnDriversRemove" Content="Remove row"/>
            </StackPanel>

            <DataGrid x:Name="GridDrivers" CanUserAddRows="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Maker" Binding="{Binding Maker}" Width="90"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="2*"/>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="70"/>
                <DataGridTextColumn Header="Machine type" Binding="{Binding MachineType}" Width="100"/>
                <DataGridTextColumn Header="Model pattern" Binding="{Binding ModelPattern}" Width="*"/>
                <DataGridTextColumn Header="Folder (under Drivers)" Binding="{Binding Path}" Width="2*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Media -->
      <TabItem x:Name="TabMedia" Header="Media">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="Build deployment media"/>
          <TextBlock Style="{StaticResource Hint}" Text="Builds WinPE with the deploy tool inside, using the settings from this content root. Needs the Windows ADK and the WinPE add-on on this PC. The build opens its own window and takes several minutes."/>

          <Border x:Name="BrdAdk" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnAdkDownload" Content="Download ADK" Margin="8,0,0,0"/>
                <Button x:Name="BtnAdkCheck" Content="Check again" Margin="8,0,0,0"/>
              </StackPanel>
              <TextBlock x:Name="TxtAdk" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>

          <TextBlock Style="{StaticResource Hint}" Text="A USB stick deploys offline: WinPE plus the answer files, their images and drivers. For a VM or a PC without a stick, Build network boot image on the Computers tab also makes Boot\Deploy-WinPE.iso, which loads everything from the share."/>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>

            <Label Content="USB disk"/>
            <ComboBox x:Name="CmbUsb" Grid.Column="1" DisplayMemberPath="Label"/>
            <Button x:Name="BtnUsbRefresh" Grid.Column="2" Content="Refresh" Margin="8,0,0,0"/>

            <Label Grid.Row="2" Content="Copy content to USB" VerticalAlignment="Top"/>
            <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
              <TextBlock x:Name="TxtUsbMode" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" FontWeight="SemiBold"/>
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,4"
                         Text="The stick gets the answer files checked below, the image each one deploys, drivers, applications and config. An answer file names the image it deploys (Answer Files tab, Image page). Only the images of the checked answer files go on the stick. Click a line to check or uncheck it."/>
              <ListBox x:Name="LstMediaAnswers" SelectionMode="Multiple" MaxHeight="160" ItemTemplate="{DynamicResource CheckItemTemplate}"/>
            </DockPanel>

            <Label Grid.Row="4" Content="Driver packs on USB" VerticalAlignment="Top"/>
            <DockPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2">
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,4"
                         Text="Check the packs for the models this stick will image. A PC whose pack is left off gets its maker's fallback pack if that is checked, otherwise Windows inbox drivers. Packs come from the Driver Library tab."/>
              <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                <Button x:Name="BtnMediaPacksAll" DockPanel.Dock="Left" Content="Check all"/>
                <Button x:Name="BtnMediaPacksNone" DockPanel.Dock="Left" Content="Uncheck all" Margin="8,0,0,0"/>
                <TextBlock x:Name="TxtMediaPacks" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </DockPanel>
              <ListBox x:Name="LstMediaPacks" SelectionMode="Multiple" MaxHeight="160" ItemTemplate="{DynamicResource CheckItemTemplate}"/>
            </DockPanel>


            <Label Grid.Row="8" Content="WinPE password" VerticalAlignment="Top"/>
            <StackPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2">
              <StackPanel Orientation="Horizontal">
                <PasswordBox x:Name="PwdWinPE" Width="200"/>
                <TextBlock Text="Again" VerticalAlignment="Center" Margin="12,0,8,0"/>
                <PasswordBox x:Name="PwdWinPE2" Width="200"/>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"
                         Text="Required, at least 8 characters. WinPE asks for this one password when it starts, and nothing else: the join, local Administrator, share and other passwords go inside the boot image, encrypted with it. Not saved: type it for each build or update."/>
            </StackPanel>
          </Grid>


          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button x:Name="BtnBuild" Content="Build media" Style="{StaticResource Primary}"/>
          </StackPanel>
          <!-- Shown only when the console could not add these folders to Defender's exclusions itself (Add-ScanExclusions.ps1). -->
          <Border x:Name="BdrScanTip" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,8" Background="{DynamicResource InfoSoftBrush}" BorderBrush="{DynamicResource InfoLineBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
              <TextBlock x:Name="TxtScanTip" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="BtnScanTipOpen" Content="Open Windows Security"/>
                <Button x:Name="BtnScanTipCopy" Content="Copy the folders" Margin="8,0,0,0"/>
                <Button x:Name="BtnScanTipDone" Content="Done, hide this" Margin="8,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Answer files -->
      <TabItem x:Name="TabAnswers" Header="Answer Files">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Answer files"/>
            <TextBlock Style="{StaticResource Hint}" Text="An answer file is one deployment profile: image, applications, disk, regional settings, computer naming, domain join, tasks and shares. The PC picks one at boot, and the Computers tab picks one for each reimage. Passwords are saved in the answer file, encrypted; the key stays in config\secrets."/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnAnswerNew" Content="New..." Style="{StaticResource Primary}"/>
            <Button x:Name="BtnAnswerEdit" Content="Edit"/>
            <Button x:Name="BtnAnswerDelete" Content="Delete" ToolTip="Deletes the selected answer file after asking. Its image and applications stay."/>
          </StackPanel>
          <TextBox x:Name="TxtAnswerIssues" DockPanel.Dock="Bottom" Height="90" Margin="0,10,0,0" IsReadOnly="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Foreground="{DynamicResource ErrorBrush}"/>
          <DataGrid x:Name="GridAnswers" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
              <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="90"/>
              <DataGridTextColumn Header="Image" Binding="{Binding Image}" Width="2*"/>
              <DataGridTextColumn Header="Apps" Binding="{Binding Apps}" Width="50"/>
              <DataGridTextColumn Header="Joins" Binding="{Binding Joins}" Width="*"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- Applications and tasks -->
      <TabItem x:Name="TabLibrary" Header="Apps and Tasks">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource SectionTitle}" Text="Applications and tasks"/>
            <TextBlock Style="{StaticResource Hint}" Text="Applications: an installer with its silent command, detection rules and the PCs it is for, installed at first boot. Tasks: scripts to run during or after a deployment (PowerShell, batch or a program) with arguments, timeout and success exit codes; POSTIMAGE and FIRSTBOOT runs are logged in C:\Windows\Temp\Task-&lt;name&gt;.log on the PC. Answer files pick which ones each PC gets."/>
          </StackPanel>
          <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnAppNew" Content="New application..." Style="{StaticResource Primary}"/>
            <Button x:Name="BtnTaskNew" Content="New task..."/>
            <Button x:Name="BtnLibEdit" Content="Edit"/>
            <Button x:Name="BtnLibDelete" Content="Delete"/>
          </WrapPanel>
          <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Find an app online:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtAppFind" Grid.Column="1" VerticalContentAlignment="Center"
                     ToolTip="Type the application's name (VLC, 7-Zip, Notepad++, Adobe Reader...) and press Enter or Search"/>
            <Button x:Name="BtnAppFind" Grid.Column="2" Content="Search" Margin="6,0,0,0" IsDefault="False"/>
            <ComboBox x:Name="CmbAppFound" Grid.Column="3" Margin="6,0,0,0" IsEnabled="False"
                      ToolTip="Results from Microsoft's winget catalog: name, id and latest version"/>
            <Button x:Name="BtnAppFoundAdd" Grid.Column="4" Content="Add" Margin="6,0,0,0" IsEnabled="False" Style="{StaticResource Primary}"
                    ToolTip="Adds the application: the PC downloads it from the publisher when it installs it and checks the file's SHA256"/>
          </Grid>
          <TextBox x:Name="TxtLibIssues" DockPanel.Dock="Bottom" Height="90" Margin="0,10,0,0" IsReadOnly="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
          <DataGrid x:Name="GridLibrary" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
              <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90"/>
              <DataGridTextColumn Header="Runs" Binding="{Binding Runs}" Width="120"/>
              <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="2*"/>
              <DataGridTextColumn Header="For" Binding="{Binding For}" Width="*"/>
              <DataGridTextColumn Header="Used by" Binding="{Binding UsedBy}" Width="*"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- Settings -->
      <TabItem x:Name="TabSettings" Header="Deploy Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,16,0">
            <StackPanel.Resources>
              <Style x:Key="SettingsHead" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,18,0,4"/>
              </Style>
            </StackPanel.Resources>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Deploy settings"/>
            <TextBlock Style="{StaticResource Hint}" Text="How PCs reach the deployment, where they report, and what they check at the end. Everything else about a deployment is in the answer files."/>

            <!-- 1. Where the deployment comes from -->
            <TextBlock Style="{StaticResource SettingsHead}" Text="1. Network share"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="The content root on your server. Network boot and the Computers tab load from it, and every PC reports its progress to its Status folder for the Dashboard (a USB stick still deploys from the stick). Leave it empty to use USB sticks only."/>
            <Grid x:Name="PnlSharePath">
              <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Label Content="Share"/>
              <TextBox x:Name="TxtSharePath" Grid.Column="1" ToolTip="For example \\SERVER01\Deploy."/>
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="After the restart, Windows reports as the computer account: give Domain Computers Modify on the share's Status folder, or the PC shows Stalled after first boot."/>

            <!-- 2. The account -->
            <StackPanel x:Name="PnlShareAccount">
              <TextBlock Style="{StaticResource SettingsHead}" Text="2. Account WinPE signs in with"/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="An Active Directory account that can read the share (and write to its Status folder). Leave it empty if the share allows guests. The password is saved encrypted (AES-256) in deploy-settings.json, like the answer files' passwords: there is no password file."/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
                <Label Content="Account"/>
                <TextBox x:Name="TxtShareUser" Grid.Column="1" Width="320" HorizontalAlignment="Left" ToolTip="CORP\svc-deploy or svc-deploy@corp.example.com"/>
                <Label Grid.Row="2" Content="Password"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                  <PasswordBox x:Name="PwdShare" Width="320" Padding="4,3" VerticalContentAlignment="Center"/>
                  <TextBlock x:Name="TxtSharePwState" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="BtnShareTest" Content="Test connection"/>
                  <TextBlock x:Name="TxtShareTest" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="560"/>
                </StackPanel>
              </Grid>
            </StackPanel>

            <!-- 3. Active Directory, for the Computers tab -->
            <TextBlock Style="{StaticResource SettingsHead}" Text="3. Active Directory"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="The Computers tab reads Active Directory with the account above, or with your own sign-in when there is none. The domain comes from the domain controller's full name or the account (user@corp.local), else it is the domain this PC is joined to."/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Label Content="Domain controller"/>
              <TextBox x:Name="TxtAdServer" Grid.Column="1" Width="320" HorizontalAlignment="Left" ToolTip="For example dc01.corp.local. Leave it empty when this PC is joined to the domain."/>
            </Grid>

            <!-- 4. Checks -->
            <TextBlock Style="{StaticResource SettingsHead}" Text="4. Checks after deploy"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8"
                       Text="At the end of first boot, every PC checks its name, domain join, applications, device drivers and BitLocker, and the result shows on the Dashboard (BitLocker and driver problems are warnings)."/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Label Content="Ignore devices"/>
              <TextBox x:Name="TxtCheckIgnore" Grid.Column="1"
                       ToolTip="Device names or ids to leave out of the driver check, separated by semicolons. Wildcards work, for example *Smart Card*; PCI\VEN_8086&amp;DEV_9D3A*"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
              <Button x:Name="BtnSettingsSave" Content="Save" Style="{StaticResource Primary}"/>
              <TextBlock x:Name="TxtSettingsProblem" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" MaxWidth="700"/>
            </StackPanel>
            <Border x:Name="BdrSettingsStale" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,8" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningLineBrush}" BorderThickness="1" CornerRadius="8">
              <DockPanel>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="Saved. WinPE reads these settings from the boot image, so update or rebuild your USB sticks (and the Computers tab's network boot image) before the next deploy."/>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Computers in Active Directory -->
      <TabItem x:Name="TabComputers" Header="Computers">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <DockPanel MinHeight="760" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Style="{StaticResource SectionTitle}" Text="Computers in Active Directory"/>
              <TextBlock Style="{StaticResource Hint}" Text="Lists the computers in your domain. Select PCs that are on and click Reimage: each one gets WinPE from the network boot image, restarts into it and deploys the answer file without anyone at the PC, keeping its name and OU. Progress then shows on the Dashboard. The PCs need PowerShell remoting (WinRM) on, with your account as administrator; the image comes from the network share on the Deploy Settings tab, and Active Directory is read with the account and domain controller set there."/>
            </StackPanel>
            <GroupBox DockPanel.Dock="Top" Header="1. Find computers" Padding="12,10" Margin="0,4,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120"/><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Name or IP" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtAdName" Grid.Column="1" ToolTip="Part of a name (LAB), a pattern (LAB-*), an IP address (10.1.2.34), or a name and its IP (GWHZLG3 10.1.2.34) when DNS has an old address. Empty = all."/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                  <Button x:Name="BtnAdSearch" MinWidth="120" Content="Search" Margin="0,0,10,0"/>
                </StackPanel>
              </Grid>
            </GroupBox>
            <GroupBox DockPanel.Dock="Bottom" Header="2. Reimage the selected PCs" Padding="12,10" Margin="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="0"/><RowDefinition Height="0"/><RowDefinition Height="12"/><RowDefinition/><RowDefinition Height="14"/><RowDefinition/></Grid.RowDefinitions>
                <Label Content="Answer file" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbAdAnswer" Grid.Column="1" Width="260" HorizontalAlignment="Left"/>
                <Label Grid.Row="4" Content="Boot image" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtAdBoot" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="BtnAdReimage" MinWidth="120" Content="Reimage..." Style="{StaticResource Primary}" Margin="0,0,10,0"/>
                  <Button x:Name="BtnAdCancel" MinWidth="120" Content="Cancel reimage" Margin="0,0,10,0" ToolTip="Removes the waiting job of the selected PCs. A PC whose deploy has started is not stopped."/>
                  <Button x:Name="BtnAdBuildBoot" Content="Build network boot image"
                          ToolTip="Builds WinPE with the deploy tool, without a WinPE password, into Boot on the content root: boot.wim for reimaging, and Deploy-WinPE.iso of the same WinPE to boot a VM or a PC without a stick. Rebuild it after updating the tool or the share settings."/>
                </StackPanel>
              </Grid>
            </GroupBox>
            <DataGrid x:Name="GridAd" IsReadOnly="True" SelectionMode="Extended" MinHeight="180">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                <DataGridTextColumn Header="IP address" Binding="{Binding IpAddress}" Width="120"/>
                <DataGridTextColumn Header="OU" Binding="{Binding OUPath}" Width="*"/>
                <DataGridTextColumn Header="Operating system" Binding="{Binding OperatingSystem}" Width="*"/>
                <DataGridTextColumn Header="Last logon" Binding="{Binding LastLogonText}" Width="110"/>
                <DataGridTextColumn Header="Online" Binding="{Binding Online}" Width="80">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding OnlineDetail}"/></Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Reimage" Binding="{Binding Reimage}" Width="*"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Dashboard -->
      <TabItem x:Name="TabDashboard" Header="Dashboard">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <DockPanel MinHeight="480" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Style="{StaticResource SectionTitle}" Text="Deployment dashboard"/>
              <TextBlock Style="{StaticResource Hint}" Text="Each PC reports its progress while it deploys: from WinPE to the Status folder, then from Windows at first boot while applications install. At the end of first boot it runs the post-deploy checks; the Result column says whether the PC is ready, and the details below give drivers, applications, tasks, domain join, BitLocker and total time, one line each. A PC that stops reporting is shown as Stalled. First boot reports as the computer account, so the status share must let Domain Computers write to it. PCs deployed from a USB stick that could not reach the share show up here when you plug the stick into this PC. Show: History lists deployments removed or cleared from here, with their final log."/>
              <UniformGrid Rows="1" Margin="0,0,0,12">
                <UniformGrid.Resources>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="Padding" Value="14,10"/>
                    <Setter Property="Margin" Value="0,0,8,0"/>
                  </Style>
                </UniformGrid.Resources>
                <Border><StackPanel><TextBlock x:Name="TxtDashRunning" Text="0" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Deploying" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
                <Border><StackPanel><TextBlock x:Name="TxtDashSucceeded" Text="0" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/><TextBlock Text="Succeeded" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
                <Border><StackPanel><TextBlock x:Name="TxtDashWarning" Text="0" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/><TextBlock Text="With warnings" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
                <Border><StackPanel><TextBlock x:Name="TxtDashFailed" Text="0" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource ErrorBrush}"/><TextBlock Text="Failed or stalled" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
                <Border Margin="0"><StackPanel><TextBlock x:Name="TxtDashTotal" Text="0" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="PCs listed" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
              </UniformGrid>
            </StackPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <Label Content="Show"/>
              <ComboBox x:Name="CmbDashFilter" Width="150" SelectedIndex="0" VerticalContentAlignment="Center">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="Deploying"/>
                <ComboBoxItem Content="Failed or stalled"/>
                <ComboBoxItem Content="Finished"/>
                <ComboBoxItem Content="History"/>
              </ComboBox>
              <Button x:Name="BtnDashOpen" DockPanel.Dock="Right" Content="Open folder" Margin="8,0,0,0"/>
              <Button x:Name="BtnDashRemove" DockPanel.Dock="Right" Content="Remove" Margin="8,0,0,0"/>
              <TextBlock/>
            </DockPanel>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="120"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="220" MinHeight="80"/></Grid.RowDefinitions>
              <DataGrid x:Name="GridDash" IsReadOnly="True">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}"/></DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Stalled"><Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}"/></DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Warning"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/></DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="Succeeded"><Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Computer" Binding="{Binding ComputerName}" Width="120"/>
                  <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
                  <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="100"/>
                  <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="100"/>
                  <DataGridTextColumn Header="Answer file" Binding="{Binding AnswerFile}" Width="110"/>
                  <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80"/>
                  <DataGridTemplateColumn Header="Progress" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Grid Margin="2,4">
                          <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100"/>
                          <TextBlock Text="{Binding Percent, StringFormat={}{0} %}" HorizontalAlignment="Center" FontSize="11"/>
                        </Grid>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Step" Binding="{Binding Step}" Width="2*"/>
                  <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="1.5*">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="ToolTip" Value="{Binding ResultText}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ResultState}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                          <DataTrigger Binding="{Binding ResultState}" Value="NotReady"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                          <DataTrigger Binding="{Binding ResultState}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                          <DataTrigger Binding="{Binding ResultState}" Value="Ready"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Started" Binding="{Binding Started, StringFormat=MM-dd HH:mm}" Width="85"/>
                  <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="70"/>
                  <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="70"/>
                </DataGrid.Columns>
              </DataGrid>
              <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent"/>
              <TextBlock x:Name="TxtDashDetail" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource BodyBrush}"/>
              <TextBox x:Name="TxtDashLog" Grid.Row="3" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" VerticalContentAlignment="Top"/>
            </Grid>
          </DockPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
