<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application" Width="900" Height="680" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <ResourceDictionary Source="FormStyles.xaml"/>
  </Window.Resources>

  <DockPanel>
    <!-- Sections -->
    <Border DockPanel.Dock="Left" Width="190" Background="{DynamicResource SidebarBrush}">
      <ListBox x:Name="LstSections" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItem}">
        <ListBoxItem Content="Installer"/>
        <ListBoxItem Content="Install command"/>
        <ListBoxItem Content="Detection"/>
        <ListBoxItem Content="Which PCs"/>
      </ListBox>
    </Border>

    <!-- Problems and buttons -->
    <Border Style="{StaticResource EditorFooter}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="BtnSave" Content="Save" Style="{StaticResource Primary}"/>
          <Button x:Name="BtnCancel" Content="Cancel" Margin="0"/>
        </StackPanel>
        <TextBlock x:Name="TxtProblems" Style="{StaticResource ProblemsText}"/>
      </DockPanel>
    </Border>

    <Grid Margin="24,18">
      <!-- 0 Installer -->
      <ScrollViewer x:Name="Sec0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource Title}" Text="Installer"/>
          <TextBlock Style="{StaticResource Hint}" Text="Pick the installer file, or a folder when it needs other files next to it. It is read at once: type, name, version, publisher and MSI product code, then the silent command and a detection rule. A template gives known settings for common applications."/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <Label Content="Installer file or folder"/>
            <TextBox x:Name="TxtSource" Grid.Column="1" ToolTip="Copied into Applications\&lt;name&gt; when you save. When editing, leave empty to keep the files already there."/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,8">
              <Button x:Name="BtnSourceFile" Content="File..."/>
              <Button x:Name="BtnSourceFolder" Content="Folder..." Margin="0"/>
            </StackPanel>
            <Label Grid.Row="1" Content="Installer to run"/>
            <ComboBox x:Name="CmbInstaller" Grid.Row="1" Grid.Column="1" IsEditable="True" ToolTip="The file in the application folder that installs it."/>
            <Label Grid.Row="2" Content="Template"/>
            <ComboBox x:Name="CmbTemplate" Grid.Row="2" Grid.Column="1" ToolTip="Known silent switches, detection and PC limits for common applications."/>
            <TextBlock x:Name="TxtTemplateNote" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
            <Label Grid.Row="4" Content="Name"/>
            <TextBox x:Name="TxtDisplayName" Grid.Row="4" Grid.Column="1" ToolTip="The name shown in the console and the logs."/>
            <!-- The folder under Applications: made from the name for a new application, fixed once saved. -->
            <TextBox x:Name="TxtName" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtFolderNote" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
            <Label Grid.Row="6" Content="Version"/>
            <TextBox x:Name="TxtVersion" Grid.Row="6" Grid.Column="1" Width="200" HorizontalAlignment="Left" IsReadOnly="True" Foreground="{DynamicResource MutedBrush}" ToolTip="Read from the installer."/>
            <Label Grid.Row="7" Content="Publisher"/>
            <TextBox x:Name="TxtPublisher" Grid.Row="7" Grid.Column="1" IsReadOnly="True" Foreground="{DynamicResource MutedBrush}" ToolTip="Read from the installer."/>
            <Label Grid.Row="8" Content="Download from"/>
            <TextBox x:Name="TxtDownloadUrl" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                     ToolTip="https:// address of the installer. The PC downloads it at first boot (saved as Installer to run) when it is not in the folder, so you can leave the installer file empty."/>
            <TextBlock Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                       Text="Optional. With an address here you can leave the installer file empty: each PC downloads it at first boot, so it needs internet then. A template with a download fills it in when you pick it with no installer picked."/>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- 1 Install command -->
      <ScrollViewer x:Name="Sec1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource Title}" Text="Install command"/>
          <TextBlock Style="{StaticResource Hint}" Text="Runs with cmd /c in the application's folder, as SYSTEM, the first time the PC starts. Nobody can click through it, so it must be silent. Exit codes not in the success list mark the app as failed in C:\Windows\Temp\FirstBoot.log."/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <Label Content="Installer type"/>
            <ComboBox x:Name="CmbType" Grid.Column="1" Width="260" HorizontalAlignment="Left"/>
            <TextBlock x:Name="TxtTypeNote" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
            <Label Grid.Row="2" Content="Install command"/>
            <TextBox x:Name="TxtCommand" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" FontFamily="Consolas"/>
            <Label Grid.Row="3" Content="Success exit codes"/>
            <TextBox x:Name="TxtCodes" Grid.Row="3" Grid.Column="1" Width="200" HorizontalAlignment="Left"/>
            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,0,0,10" Text="3010 and 1641 always mean the install worked and the PC needs a restart."/>
            <Label Grid.Row="5" Content="Timeout (minutes)"/>
            <TextBox x:Name="TxtTimeout" Grid.Row="5" Grid.Column="1" Width="80" HorizontalAlignment="Left" ToolTip="The installer is stopped and marked failed after this long."/>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- 2 Detection -->
      <DockPanel x:Name="Sec2" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Style="{StaticResource Title}" Text="Detection"/>
          <TextBlock Style="{StaticResource Hint}" Text="How to tell the app is installed. Checked before installing (skipped when every rule matches, e.g. already in the image) and after (fail when the installer exited 0 but installed nothing). Target: MSI product code, program name in Programs and Features (wildcards), file path (%ProgramFiles% works), registry key (HKLM\...), MSIX package name, or a .ps1 in the app folder that exits 0 when installed."/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnRuleAdd" Content="Add rule"/>
            <Button x:Name="BtnRuleRemove" Content="Remove rule"/>
            <Button x:Name="BtnRuleTest" Content="Test on this PC"/>
          </StackPanel>
          <TextBlock x:Name="TxtRuleTest" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>
        <DataGrid x:Name="GridRules">
          <DataGrid.Columns>
            <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Type}" Width="100"/>
            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="3*"/>
            <DataGridTextColumn Header="Registry value" Binding="{Binding Value}" Width="*"/>
            <DataGridComboBoxColumn Header="Operator" SelectedItemBinding="{Binding Operator}" Width="80"/>
            <DataGridTextColumn Header="Version or data" Binding="{Binding Version}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <!-- 3 Which PCs -->
      <ScrollViewer x:Name="Sec3" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource Title}" Text="Which PCs"/>
          <TextBlock Style="{StaticResource Hint}" Text="Leave both empty to install on every PC. Otherwise the app is only installed when the PC's maker and model match (comma-separated, wildcards allowed: Latitude*, ThinkPad T14*). Lenovo models also match their 4-character machine type (21HD). Checked in WinPE, so skipped apps are not even copied."/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <Label Content="Makers"/>
            <TextBox x:Name="TxtMakers" Grid.Column="1" ToolTip="Dell, HP, Lenovo, or the manufacturer as WMI reports it."/>
            <Label Grid.Row="1" Content="Models"/>
            <TextBox x:Name="TxtModels" Grid.Row="1" Grid.Column="1"/>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
