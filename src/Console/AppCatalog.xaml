<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Applications from the internet" Width="760" Height="540" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13" Background="White">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinWidth" Value="80"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0F6CBD"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#0F6CBD"/>
    </Style>
  </Window.Resources>
  <DockPanel Margin="20,16">
    <TextBlock DockPanel.Dock="Top" Text="Applications from the internet" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <TextBlock DockPanel.Dock="Top" Foreground="#5B6170" TextWrapping="Wrap" Margin="0,0,0,12"
               Text="Tick the applications to add, then click Add. Nothing is downloaded now: each PC downloads the newest version from the publisher at first boot, so it needs internet then. Add them to an answer file afterwards, in the order they should install (.NET 8 before Dell Command | Update)."/>
    <Border DockPanel.Dock="Bottom" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="BtnAdd" Content="Add" Style="{StaticResource Primary}"/>
          <Button x:Name="BtnClose" Content="Close" Margin="0"/>
        </StackPanel>
        <TextBlock x:Name="TxtResult" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
      </DockPanel>
    </Border>
    <ListBox x:Name="LstCatalog" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2,4">
            <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanAdd}" FontWeight="SemiBold" Content="{Binding Title}"/>
            <TextBlock Text="{Binding Detail}" Foreground="#5B6170" TextWrapping="Wrap" Margin="22,2,0,0"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
