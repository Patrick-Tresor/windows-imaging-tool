<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image versions" Width="900" Height="560" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
      <Setter Property="SelectionMode" Value="Extended"/>
      <Setter Property="IsReadOnly" Value="True"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="TxtTitle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"
                 Text="Earlier versions are kept in Images\Previous automatically when you capture over an image, update it offline or roll back. Roll back makes the selected version current again for every answer file without a version; the image you roll away from is kept as a version too. To keep one answer file on a version, pick it in the answer file's Image page."/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <DockPanel Margin="0,0,0,10">
        <TextBlock Text="Earlier versions to keep (every image)" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="TxtLimit" Width="60" VerticalContentAlignment="Center" ToolTip="How many of the newest earlier versions each image keeps; older ones are deleted when a capture, update or rollback replaces the image. 0 keeps them all. Versions an answer file uses are never deleted."/>
        <Button x:Name="BtnLimitSave" Content="Save" Margin="8,0,0,0" HorizontalAlignment="Left"/>
      </DockPanel>
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="BtnClose" Content="Close" Margin="0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="BtnRollback" Content="Roll back to selected" Style="{StaticResource Primary}"/>
          <Button x:Name="BtnDelete" Content="Delete selected"/>
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <DataGrid x:Name="GridVersions">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Version" Binding="{Binding Label}" Width="130"/>
        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=yyyy-MM-dd HH:mm}" Width="120"/>
        <DataGridTextColumn Header="How it was kept" Binding="{Binding Reason}" Width="2*"/>
        <DataGridTextColumn Header="Details" Binding="{Binding Note}" Width="2*"/>
        <DataGridTextColumn Header="Size (GB)" Binding="{Binding SizeGB}" Width="80"/>
        <DataGridTextColumn Header="Used by" Binding="{Binding UsedBy}" Width="2*"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
