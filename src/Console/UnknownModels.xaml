<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unknown Models" Width="1060" Height="600" MinWidth="780" MinHeight="400"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13" Background="White">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="MinWidth" Value="90"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0F6CBD"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#0F6CBD"/>
    </Style>
    <Style TargetType="Label">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#E1E3E8"/>
      <Setter Property="RowHeight" Value="26"/>
      <Setter Property="CanUserAddRows" Value="False"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" Text="PCs deployed without their driver pack"/>
      <TextBlock Foreground="#5B6170" TextWrapping="Wrap" Margin="0,0,0,12"
                 Text="Every deployment records which drivers the PC got. These models got the maker's generic fallback, Windows inbox drivers only, or a catalog entry whose folder is missing. Models with a pack in the vendor catalog are ticked: click Download to fetch them all. A model leaves this list once the library covers it. Already-deployed PCs keep their drivers until they are reimaged."/>
      <DockPanel Margin="0,0,0,10">
        <Label Content="Packs for"/>
        <ComboBox x:Name="CmbOs" Width="110" SelectedIndex="0">
          <ComboBoxItem Content="Windows 11"/><ComboBoxItem Content="Windows 10"/>
        </ComboBox>
        <Button x:Name="BtnOpenReports" DockPanel.Dock="Right" Content="Open reports folder"/>
        <Button x:Name="BtnRefresh" DockPanel.Dock="Right" Content="Refresh" ToolTip="Read the reports again and download the vendor catalogs again"/>
        <TextBlock/>
      </DockPanel>
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="Close"/>
      <Button x:Name="BtnDownload" DockPanel.Dock="Right" Content="Download" Style="{StaticResource Primary}"/>
      <CheckBox x:Name="ChkKeep" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0" Content="Keep downloaded files"/>
      <Button x:Name="BtnInbox" Content="Use inbox drivers" Margin="0"
              ToolTip="For the highlighted rows: add a catalog entry with no folder (e.g. for VMs or PCs that need no pack), so they leave this list and deploy without a warning"/>
      <TextBlock x:Name="TxtSelection" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#5B6170"/>
    </DockPanel>

    <DataGrid x:Name="GridModels" SelectionMode="Extended">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="" Width="34">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasPack}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Maker" Binding="{Binding Maker}" Width="80" IsReadOnly="True"/>
        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="2*" IsReadOnly="True"/>
        <DataGridTextColumn Header="SKU / type" Binding="{Binding Ids}" Width="80" IsReadOnly="True"/>
        <DataGridTextColumn Header="PCs" Binding="{Binding PCs}" Width="45" IsReadOnly="True"/>
        <DataGridTextColumn Header="Computers" Binding="{Binding Computers}" Width="*" IsReadOnly="True"/>
        <DataGridTextColumn Header="Last deployed" Binding="{Binding LastSeen}" Width="115" IsReadOnly="True"/>
        <DataGridTextColumn Header="Got" Binding="{Binding Drivers}" Width="105" IsReadOnly="True"/>
        <DataGridTextColumn Header="Vendor pack" Binding="{Binding PackText}" Width="2*" IsReadOnly="True"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
