<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Image" Width="780" Height="620" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13" Background="White">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinWidth" Value="90"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0F6CBD"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#0F6CBD"/>
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="#374151"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,4"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="16,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnStart" Content="Start update" Style="{StaticResource Primary}"/>
        <Button x:Name="BtnCancel" Content="Cancel" Margin="0"/>
      </StackPanel>
    </Border>

    <DockPanel Margin="24,20">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock x:Name="TxtTitle" Style="{StaticResource Title}" Text="Update image"/>
        <TextBlock x:Name="TxtCurrent" Style="{StaticResource Body}" FontFamily="Consolas"/>
        <TextBlock Style="{StaticResource Body}"
                   Text="Adds Windows updates to the image without a new capture. Download the latest cumulative update for this Windows version (and the .NET cumulative update) from the Microsoft Update Catalog into the content root's Updates folder. They are applied from top to bottom: put a standalone servicing stack update first."/>
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <CheckBox x:Name="ChkCleanup" IsChecked="True"
                  Content="Clean up superseded components after the updates (smaller image, takes longer)"/>
        <CheckBox x:Name="ChkResetBase" Margin="22,2,0,4"
                  Content="Also reset the base: smallest image, but these updates can no longer be uninstalled on deployed PCs"/>
        <CheckBox x:Name="ChkBackup" IsChecked="True"
                  Content="Keep the current version in Images\Previous so it can be restored"/>
        <TextBlock Style="{StaticResource Body}" Foreground="#6B7280" Margin="0,8,0,0"
                   Text="The update runs in a separate window and needs about three times the image size free on this PC's system drive. Answer files that use this image get the updated version on the next deploy."/>
      </StackPanel>

      <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
        <Button x:Name="BtnAddFiles" Content="Add files..." Margin="0,0,0,6"/>
        <Button x:Name="BtnAddFolder" Content="Add folder..." Margin="0,0,0,6"/>
        <Button x:Name="BtnRemove" Content="Remove" Margin="0,0,0,18"/>
        <Button x:Name="BtnUp" Content="Move up" Margin="0,0,0,6"/>
        <Button x:Name="BtnDown" Content="Move down" Margin="0,0,0,18"/>
        <Button x:Name="BtnOpenUpdates" Content="Open Updates folder" Margin="0"/>
      </StackPanel>

      <DataGrid x:Name="GridPackages" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                HeadersVisibility="Column" GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Update" Binding="{Binding Name}" Width="3*"/>
          <DataGridTextColumn Header="KB" Binding="{Binding KB}" Width="90"/>
          <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="80"/>
          <DataGridTextColumn Header="MB" Binding="{Binding SizeMB}" Width="60"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </DockPanel>
</Window>
