<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Image" Width="780" Height="620" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="Margin" Value="0,4"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnStart" Content="Start update" Style="{StaticResource Primary}"/>
        <Button x:Name="BtnCancel" Content="Cancel" Margin="0"/>
      </StackPanel>
    </Border>

    <DockPanel Margin="24,20">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock x:Name="TxtTitle" Style="{StaticResource Title}" Text="Update image"/>
        <TextBlock x:Name="TxtCurrent" Style="{StaticResource Body}" FontFamily="Consolas"/>
        <TextBlock Style="{StaticResource Body}"
                   Text="Adds Windows updates to the image without a new capture."/>
        <TextBlock Style="{StaticResource Body}"
                   Text="The latest cumulative update for this Windows version is downloaded from the Microsoft Update Catalog first. When the catalog can't be reached, only the packages below are added."/>
        <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource MutedBrush}"
                   Text="Other packages (the .NET cumulative update, or a cumulative update downloaded by hand when the catalog download fails) go in the list below, from the content root's Updates folder. They are applied after it, in the order listed: a servicing stack update first, then Windows, then .NET, oldest KB first."/>
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"
                   Text="Superseded components are cleaned up after the updates (a smaller image; the updates can still be uninstalled on deployed PCs). The update runs in the background, shown in the Progress window, and needs about three times the image size free on this PC's system drive. Answer files that use this image get the updated version on the next deploy. The current version is kept in Images\Previous, so Versions... can roll back to it."/>
      </StackPanel>

      <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
        <Button x:Name="BtnAddFiles" Content="Add files..." Margin="0,0,0,6"/>
        <Button x:Name="BtnAddFolder" Content="Add folder..." Margin="0,0,0,6"/>
        <Button x:Name="BtnRemove" Content="Remove" Margin="0,0,0,18"/>
        <Button x:Name="BtnOpenUpdates" Content="Open Updates folder" Margin="0"/>
      </StackPanel>

      <DataGrid x:Name="GridPackages" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                HeadersVisibility="Column" GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Update" Binding="{Binding Name}" Width="3*"/>
          <DataGridTextColumn Header="KB" Binding="{Binding KB}" Width="90"/>
          <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="80"/>
          <DataGridTextColumn Header="MB" Binding="{Binding SizeMB}" Width="60"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </DockPanel>
</Window>
