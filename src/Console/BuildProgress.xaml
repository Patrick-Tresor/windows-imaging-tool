<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Progress" Width="820" Height="640" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">

  <!-- One window for everything that runs: each build, capture, download or reimage is one card (JobCardTemplate in Styles.xaml),
       newest at the bottom (Patrick, 2026-11-22: one window instead of one per reimage). Driver pack downloads are not
       here: they show on the Driver library page (Patrick, 2026-11-27). -->

  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock x:Name="TxtCount" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
      <TextBlock x:Name="TxtHeader" FontSize="18" FontWeight="SemiBold" Text="Progress"/>
    </DockPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="Close"/>
      <TextBlock x:Name="TxtNote" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"
                 Text="Closing this window does not stop what runs. Show progress brings it back. It closes by itself once everything is done."/>
    </DockPanel>

    <ScrollViewer x:Name="ScrollJobs" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="LstJobs" ItemTemplate="{DynamicResource JobCardTemplate}"/>
    </ScrollViewer>
  </DockPanel>
</Window>
