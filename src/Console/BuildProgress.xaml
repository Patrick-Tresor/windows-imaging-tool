<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Build progress" Width="820" Height="600" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <DockPanel>
        <TextBlock x:Name="TxtElapsed" DockPanel.Dock="Right" FontSize="18" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
        <TextBlock x:Name="TxtTitle" FontSize="18" FontWeight="SemiBold" Text="Building media" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <TextBlock x:Name="TxtSummary" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Text="Starting..."/>
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="Close"/>
      <Button x:Name="BtnLog" DockPanel.Dock="Right" Content="Open log" IsEnabled="False"/>
      <Button x:Name="BtnWindow" DockPanel.Dock="Right" Content="Show build window"
              ToolTip="The build's own window, with every line DISM and the copy print"/>
      <TextBlock x:Name="TxtNote" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"
                 Text="Closing this window does not stop the build."/>
    </DockPanel>

    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10">
      <ScrollViewer x:Name="ScrollSteps" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="LstSteps" ItemTemplate="{StaticResource StepRowTemplate}"/>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
