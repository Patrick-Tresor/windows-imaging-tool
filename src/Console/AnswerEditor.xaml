<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Answer File" Width="920" Height="660" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <ResourceDictionary Source="FormStyles.xaml"/>
  </Window.Resources>

  <DockPanel>
    <!-- Sections -->
    <Border DockPanel.Dock="Left" Width="190" Background="{DynamicResource SidebarBrush}">
      <ListBox x:Name="LstSections" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItem}">
        <ListBoxItem Content="General"/>
        <ListBoxItem Content="Image and disk"/>
        <ListBoxItem Content="Applications"/>
        <ListBoxItem Content="Windows settings"/>
        <ListBoxItem Content="Computer name"/>
        <ListBoxItem Content="Domain or workgroup"/>
        <ListBoxItem Content="Tasks"/>
        <ListBoxItem Content="BitLocker"/>
      </ListBox>
    </Border>

    <!-- Problems and buttons -->
    <Border Style="{StaticResource EditorFooter}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="BtnSave" Content="Save" Style="{StaticResource Primary}"/>
          <Button x:Name="BtnCancel" Content="Cancel" Margin="0"/>
        </StackPanel>
        <TextBlock x:Name="TxtProblems" Style="{StaticResource ProblemsText}"/>
      </DockPanel>
    </Border>

    <Grid Margin="24,18">
      <!-- 0 General -->
      <ScrollViewer x:Name="Sec0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource Title}" Text="General"/>
          <TextBlock Style="{StaticResource Hint}" Text="How the deployment starts and ends on the PC."/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <Label Content="Answer file name"/>
            <TextBox x:Name="TxtName" Grid.Column="1" ToolTip="Letters, digits, dot, dash and underscore. Shown in the menu on the PC."/>
            <Label Grid.Row="1" Content="Mode"/>
            <StackPanel Grid.Row="1" Grid.Column="1">
              <RadioButton x:Name="RbInteractive" GroupName="Mode" Content="Interactive: the technician picks this answer file and types YES"/>
              <RadioButton x:Name="RbUnattended" GroupName="Mode" Content="Unattended: start automatically after a 10 second countdown (any key opens the wizard instead)"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- 1 Image and disk -->
      <ScrollViewer x:Name="Sec1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource Title}" Text="Image and disk"/>
          <TextBlock Style="{StaticResource Hint}" Text="Which image goes on the PC. It goes on the first internal disk (NVMe, then SATA, never the USB stick), which is erased and repartitioned; the technician can pick another disk in the deploy wizard."/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <Label Content="Image"/>
            <ComboBox x:Name="CmbImage" Grid.Column="1" IsEditable="True" ToolTip="An image in the Images folder."/>
            <Label Grid.Row="1" Content="Version"/>
            <ComboBox x:Name="CmbVersion" Grid.Row="1" Grid.Column="1" Width="420" HorizontalAlignment="Left" DisplayMemberPath="Display"
                      ToolTip="Current follows the image as it is updated or rolled back. An earlier version keeps this answer file on that copy from Images\Previous."/>
            <Label x:Name="LblIndex" Grid.Row="2" Content="Edition (index)"/>
            <ComboBox x:Name="CmbIndex" Grid.Row="2" Grid.Column="1" IsEditable="True" Width="420" HorizontalAlignment="Left"/>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- 2 Applications -->
      <DockPanel x:Name="Sec2" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Style="{StaticResource Title}" Text="Applications"/>
          <TextBlock Style="{StaticResource Hint}" Text="Installed in this order the first time the PC starts, before anyone logs on. Apps limited to other makers or models are skipped on that PC. New application opens the application pack builder; manage packs on the Apps and Tasks tab."/>
        </StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Available" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Button x:Name="BtnNewApp" DockPanel.Dock="Bottom" Content="New application..." HorizontalAlignment="Left" Margin="0,8,0,0"/>
            <ListBox x:Name="LstAvailable" DisplayMemberPath="Name"/>
          </DockPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
            <Button x:Name="BtnAppAdd" Content="Add &gt;" Margin="0,0,0,8"/>
            <Button x:Name="BtnAppRemove" Content="&lt; Remove" Margin="0"/>
          </StackPanel>
          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Install order" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ListBox x:Name="LstSelected"/>
          </DockPanel>
          <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
            <Button x:Name="BtnAppUp" Content="Up" Margin="0,0,0,8"/>
            <Button x:Name="BtnAppDown" Content="Down" Margin="0"/>
          </StackPanel>
        </Grid>
      </DockPanel>

      <!-- 3 Windows settings -->
      <ScrollViewer x:Name="Sec3" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource Title}" Text="Windows settings"/>
          <TextBlock Style="{StaticResource Hint}" Text="Owner, product key, time zone and languages for the new Windows."/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
              <RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <Label Content="Full name"/>
            <TextBox x:Name="TxtFullName" Grid.Column="1"/>
            <Label Grid.Row="1" Content="Organization"/>
            <TextBox x:Name="TxtOrg" Grid.Row="1" Grid.Column="1"/>
            <Label Grid.Row="2" Content="Product key"/>
            <TextBox x:Name="TxtProductKey" Grid.Row="2" Grid.Column="1" ToolTip="Leave empty to keep the image's key or KMS / digital licence activation."/>
            <Label Grid.Row="3" Content="Time zone"/>
            <ComboBox x:Name="CmbTimeZone" Grid.Row="3" Grid.Column="1" IsEditable="True"/>
            <Label Grid.Row="4" Content="System language"/>
            <ComboBox x:Name="CmbLanguage" Grid.Row="4" Grid.Column="1" IsEditable="True" Width="260" HorizontalAlignment="Left" ToolTip="Display language, system locale and main keyboard, for example fr-CA. Must be a language installed in the image."/>
            <Label Grid.Row="5" Content="Fallback language"/>
            <ComboBox x:Name="CmbFallback" Grid.Row="5" Grid.Column="1" IsEditable="True" Width="260" HorizontalAlignment="Left" ToolTip="For example en-US: used for untranslated text, added as the second keyboard (Windows+Space) and for date and number formats. Leave empty for one language only."/>
            <Label Grid.Row="7" Content="Built-in Administrator"/>
            <CheckBox x:Name="ChkAdmin" Grid.Row="7" Grid.Column="1" Content="Enable it with this password (needed to skip the local account page in Windows setup)"/>
            <StackPanel Grid.Row="8" Grid.Column="1">
              <PasswordBox x:Name="PwdAdmin" Width="260" HorizontalAlignment="Left"/>
              <TextBlock x:Name="TxtAdminPwState" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- 4 Computer name -->
      <ScrollViewer x:Name="Sec4" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource Title}" Text="Computer name"/>
          <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="How new PCs are named. Names keep letters, digits and dashes and are cut to 15 characters. A PC reimaged from the Computers tab keeps its name and OU."/>
          <RadioButton x:Name="RbNameWmi" GroupName="Naming" Content="From the hardware (WMI), for example the serial number" Margin="0,8,0,0"/>
          <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="22,0,0,4" Text="Prefix + the value the WMI query returns on each PC."/>
          <RadioButton x:Name="RbNameCustom" GroupName="Naming" Content="Custom scheme"/>
          <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="22,0,0,4" Text="{}Prefix + the scheme: # is a random digit and {SERIAL} the serial number, for example LAB-#### or {SERIAL}-A."/>
          <RadioButton x:Name="RbNamePrompt" GroupName="Naming" Content="Ask the technician"/>
          <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="22,0,0,4" Text="The deploy wizard asks for the name, with the hardware name filled in. An unattended deploy uses the hardware name."/>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <Label Content="Prefix"/>
            <TextBox x:Name="TxtPrefix" Grid.Column="1" Width="160" HorizontalAlignment="Left" ToolTip="Optional, for example LAB-"/>
            <Label x:Name="LblWmi" Grid.Row="1" Content="WMI query"/>
            <StackPanel x:Name="PnlWmi" Grid.Row="1" Grid.Column="1">
              <ComboBox x:Name="CmbWmi" IsEditable="True">
                <ComboBoxItem Content="SELECT SerialNumber FROM Win32_BIOS"/>
                <ComboBoxItem Content="SELECT SerialNumber FROM Win32_SystemEnclosure"/>
                <ComboBoxItem Content="SELECT IdentifyingNumber FROM Win32_ComputerSystemProduct"/>
                <ComboBoxItem Content="SELECT SMBIOSAssetTag FROM Win32_SystemEnclosure"/>
              </ComboBox>
              <TextBlock x:Name="TxtWmiMeaning" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
            </StackPanel>
            <Label x:Name="LblScheme" Grid.Row="2" Content="Custom scheme"/>
            <TextBox x:Name="TxtScheme" Grid.Row="2" Grid.Column="1" ToolTip="# = random digit, {SERIAL} = BIOS serial. Example: LAB-####"/>
            <Label Grid.Row="3" Content="Example on this PC"/>
            <StackPanel Grid.Row="3" Grid.Column="1">
              <TextBlock x:Name="TxtNamePreview" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,2"/>
              <TextBlock x:Name="TxtNamePreviewNote" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- 5 Domain or workgroup -->
      <ScrollViewer x:Name="Sec5" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource Title}" Text="Domain or workgroup"/>
          <TextBlock Style="{StaticResource Hint}" Text="To join a domain, fill in the domain, the user name of the account that joins PCs to it, and that account's password. The password is saved in the answer file, encrypted with the key in config\secrets\answer-key.txt; WinPE decrypts it without asking. Use an account that can only join computers to the OU."/>
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="RbDomain" GroupName="Join" Content="Join a domain"/>
            <RadioButton x:Name="RbWorkgroup" GroupName="Join" Content="Join a workgroup"/>
          </StackPanel>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <Label Content="Domain"/>
            <TextBox x:Name="TxtDomain" Grid.Column="1" ToolTip="corp.example.com"/>
            <Label Grid.Row="1" Content="Organizational unit"/>
            <TextBox x:Name="TxtOU" Grid.Row="1" Grid.Column="1" ToolTip="OU=Laptops,DC=corp,DC=example,DC=com. Leave empty for the default Computers container."/>
            <Label Grid.Row="2" Content="Join account user name"/>
            <TextBox x:Name="TxtJoinUser" Grid.Row="2" Grid.Column="1" Width="260" HorizontalAlignment="Left" ToolTip="The account that joins PCs to the domain, such as svc-join. CORP\svc-join or svc-join@corp.example.com also work; the account's domain then comes from it."/>
            <Label Grid.Row="3" Content="Account's domain"/>
            <TextBox x:Name="TxtJoinDomain" Grid.Row="3" Grid.Column="1" Width="260" HorizontalAlignment="Left" ToolTip="NetBIOS name such as CORP. Leave empty to use the domain above."/>
            <Label Grid.Row="4" Content="Join account password"/>
            <StackPanel Grid.Row="4" Grid.Column="1">
              <PasswordBox x:Name="PwdJoin" Width="260" HorizontalAlignment="Left"/>
              <TextBlock x:Name="TxtJoinPwState" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
            </StackPanel>
            <Label Grid.Row="5" Content="Workgroup"/>
            <TextBox x:Name="TxtWorkgroup" Grid.Row="5" Grid.Column="1" Width="260" HorizontalAlignment="Left"/>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- 6 Tasks -->
      <DockPanel x:Name="Sec6" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Style="{StaticResource Title}" Text="Tasks"/>
          <TextBlock Style="{StaticResource Hint}" Text="Tasks from the Apps and Tasks tab, run in this order. POSTIMAGE: in WinPE once the image and drivers are applied (%OSDRIVE% is the new Windows drive, %DEPLOYROOT% the content root). FIRSTBOOT: on the PC as SYSTEM, after the applications. FIRSTLOGON: when the first user logs on. Arguments are optional. New task opens the task builder."/>
        </StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Available" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Button x:Name="BtnTaskNew" DockPanel.Dock="Bottom" Content="New task..." HorizontalAlignment="Left" Margin="0,8,0,0"/>
            <ListBox x:Name="LstTaskLibrary" DisplayMemberPath="Name" ToolTip="Tasks on the Apps and Tasks tab. Double-click to add one."/>
          </DockPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
            <Button x:Name="BtnTaskAdd" Content="Add &gt;" Margin="0,0,0,8"/>
            <Button x:Name="BtnTaskRemove" Content="&lt; Remove" Margin="0"/>
          </StackPanel>
          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Run order" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DataGrid x:Name="GridTasks">
              <DataGrid.Columns>
                <DataGridComboBoxColumn Header="When" SelectedItemBinding="{Binding Phase}" Width="120"/>
                <DataGridTextColumn Header="Task" Binding="{Binding Task}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Arguments" Binding="{Binding Command}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
          <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
            <Button x:Name="BtnTaskUp" Content="Up" Margin="0,0,0,8"/>
            <Button x:Name="BtnTaskDown" Content="Down" Margin="0"/>
          </StackPanel>
        </Grid>
      </DockPanel>

      <!-- 7 BitLocker -->
      <ScrollViewer x:Name="Sec7" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource Title}" Text="BitLocker"/>
          <TextBlock Style="{StaticResource Hint}" Text="Turned on at first boot, after the applications and tasks. The recovery password is backed up before anything is encrypted. The PC needs a TPM that is turned on in its firmware settings."/>
          <CheckBox x:Name="ChkBitLocker" Content="Encrypt the Windows drive with BitLocker"/>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <Label Content="Recovery key backup"/>
            <CheckBox x:Name="ChkBlAD" Grid.Column="1" Content="Active Directory (on the computer object; domain join only)"/>
            <Label Grid.Row="1" Content="Also save to folder"/>
            <TextBox x:Name="TxtBlFolder" Grid.Row="1" Grid.Column="1" ToolTip="\\server\share\BitLocker. One text file per PC. Domain Computers need write access; restrict who can read it."/>
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Text="The TPM unlocks the drive at startup (no PIN) and XTS-AES 256 is used. Only the used space is encrypted (the disk was just wiped), and BitLocker stays off when no recovery key backup worked."/>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
