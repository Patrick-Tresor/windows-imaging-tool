{
  "_comment": "Starting points for the console's application pack builder. {installer} becomes the installer's file name. Entries with verify=true are best guesses: test them on a VM before deploying.",
  "templates": [
    {
      "name": "Lenovo-System-Update",
      "aliases": ["LenovoSystemUpdate", "Lenovo System Update"],
      "match": ["system_update_*.exe"],
      "displayName": "Lenovo System Update",
      "publisher": "Lenovo",
      "installerType": "inno",
      "command": "\"{installer}\" /VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP-",
      "requirements": { "makers": ["Lenovo"] },
      "detection": { "match": "any", "rules": [
        { "type": "file", "target": "%ProgramFiles(x86)%\\Lenovo\\System Update\\tvsu.exe" },
        { "type": "uninstall", "target": "Lenovo System Update*" }
      ] },
      "timeoutMinutes": 20,
      "verify": false,
      "notes": "Only installed on Lenovo PCs."
    },
    {
      "name": "Dell-Command-Update",
      "aliases": ["DellCommandUpdate", "Dell Command Update", "DCU"],
      "match": ["Dell-Command-Update*.exe", "*Command-Update-Windows-Universal*.exe"],
      "displayName": "Dell Command | Update",
      "publisher": "Dell",
      "installerType": "exe",
      "command": "\"{installer}\" /s",
      "requirements": { "makers": ["Dell"] },
      "detection": { "match": "any", "rules": [
        { "type": "file", "target": "%ProgramFiles%\\Dell\\CommandUpdate\\dcu-cli.exe" },
        { "type": "uninstall", "target": "Dell Command | Update*" }
      ] },
      "timeoutMinutes": 30,
      "verify": false,
      "notes": "Dell does not publish a fixed download address, so pick the installer from dell.com/support. Dell Update Package (/s is silent). Only installed on Dell PCs. Version 5 needs the .NET 8 Desktop Runtime: put the DotNet-Desktop-Runtime-8 application before this one in the answer file. Without it the package exits 4 (a required component is missing)."
    },
    {
      "name": "DotNet-Desktop-Runtime-8",
      "aliases": ["DotNet-Desktop-Runtime", ".NET Desktop Runtime", "Windows Desktop Runtime", "dotnet8"],
      "match": ["windowsdesktop-runtime-8.*-win-x64.exe"],
      "installer": "windowsdesktop-runtime-8-win-x64.exe",
      "download": { "url": "https://aka.ms/dotnet/8.0/windowsdesktop-runtime-win-x64.exe" },
      "displayName": "Microsoft Windows Desktop Runtime 8 (x64)",
      "publisher": "Microsoft",
      "installerType": "burn",
      "command": "\"{installer}\" /install /quiet /norestart",
      "detection": { "match": "all", "rules": [
        { "type": "uninstall", "target": "Microsoft Windows Desktop Runtime - 8.*(x64)*" }
      ] },
      "timeoutMinutes": 15,
      "verify": false,
      "notes": "From dotnet.microsoft.com (.NET 8, Desktop Runtime, Windows x64). Dell Command | Update 5 needs it, so list it before that application. The Applications tab's download tick box gives it Microsoft's link to the newest .NET 8, downloaded at first boot."
    },
    {
      "name": "Microsoft-365-Apps",
      "aliases": ["Microsoft-Office", "Office", "Microsoft Office", "Office365", "Microsoft 365", "M365"],
      "match": [],
      "installer": "setup.exe",
      "download": { "url": "https://officecdn.microsoft.com/pr/wsus/setup.exe" },
      "files": { "configuration.xml": "office-configuration.xml" },
      "displayName": "Microsoft 365 Apps",
      "publisher": "Microsoft",
      "installerType": "exe",
      "command": "\"{installer}\" /configure configuration.xml",
      "detection": { "match": "any", "rules": [
        { "type": "file", "target": "%ProgramFiles%\\Microsoft Office\\root\\Office16\\WINWORD.EXE" },
        { "type": "uninstall", "target": "Microsoft 365*" },
        { "type": "uninstall", "target": "Microsoft Office*" }
      ] },
      "timeoutMinutes": 90,
      "verify": true,
      "notes": "The Applications tab's download tick box adds the Office Deployment Tool's setup.exe (downloaded at first boot) and config\\office-configuration.xml as configuration.xml; Office itself then downloads from Microsoft. Office Deployment Tool: setup.exe plus configuration.xml in the same folder (sample in config\\office-configuration.xml). OfficeSetup.exe from office.com does not install silently: it exits 0 without installing anything. Without a Source folder Office downloads from the internet at first boot; to install offline, run setup.exe /download configuration.xml once and put the Office folder next to setup.exe."
    },
    {
      "name": "Teams",
      "aliases": ["MSTeams", "Microsoft Teams", "NewTeams"],
      "match": ["teamsbootstrapper.exe"],
      "installer": "teamsbootstrapper.exe",
      "download": { "url": "https://go.microsoft.com/fwlink/?linkid=2243204", "command": "\"teamsbootstrapper.exe\" -p" },
      "displayName": "Microsoft Teams",
      "publisher": "Microsoft",
      "installerType": "exe",
      "command": "\"{installer}\" -p -o \"%CD%\\MSTeams-x64.msix\"",
      "detection": { "match": "all", "rules": [ { "type": "appx", "target": "MSTeams" } ] },
      "timeoutMinutes": 20,
      "verify": false,
      "notes": "Choose the folder with teamsbootstrapper.exe and MSTeams-x64.msix (both from Microsoft's Teams admin download page), so it installs offline for every user. With the download tick box, the PC downloads the bootstrapper at first boot, and it downloads Teams for every user (-p)."
    },
    {
      "name": "Zoom",
      "aliases": ["ZoomWorkplace", "Zoom-Latest", "ZoomLatest"],
      "match": ["ZoomInstallerFull*.msi"],
      "installer": "ZoomInstallerFull.msi",
      "download": { "url": "https://zoom.us/client/latest/ZoomInstallerFull.msi" },
      "displayName": "Zoom Workplace",
      "publisher": "Zoom",
      "installerType": "msi",
      "command": "msiexec /i \"{installer}\" /qn /norestart",
      "detection": { "match": "any", "rules": [
        { "type": "file", "target": "%ProgramFiles%\\Zoom\\bin\\Zoom.exe" },
        { "type": "uninstall", "target": "Zoom Workplace*" }
      ] },
      "timeoutMinutes": 20,
      "verify": false,
      "notes": "Per-machine MSI. Add MSI properties from Zoom's mass deployment guide (auto-update, SSO domain) after /norestart if you need them."
    },
    {
      "name": "Google-Chrome",
      "aliases": ["Chrome", "Google Chrome", "GoogleChrome"],
      "match": ["googlechromestandaloneenterprise64*.msi", "GoogleChromeEnterprise*.msi"],
      "installer": "googlechromestandaloneenterprise64.msi",
      "download": { "url": "https://dl.google.com/dl/chrome/install/googlechromestandaloneenterprise64.msi" },
      "displayName": "Google Chrome",
      "publisher": "Google",
      "installerType": "msi",
      "command": "msiexec /i \"{installer}\" /qn /norestart",
      "detection": { "match": "any", "rules": [
        { "type": "file", "target": "%ProgramFiles%\\Google\\Chrome\\Application\\chrome.exe" },
        { "type": "uninstall", "target": "Google Chrome" }
      ] },
      "timeoutMinutes": 20,
      "verify": false,
      "notes": "Chrome Enterprise MSI (64-bit), for every user. It updates itself."
    },
    {
      "name": "Mozilla-Firefox",
      "aliases": ["Firefox", "Mozilla Firefox"],
      "match": ["Firefox Setup *.msi", "Firefox*.msi"],
      "installer": "Firefox.msi",
      "download": { "url": "https://download.mozilla.org/?product=firefox-msi-latest-ssl&os=win64&lang=fr" },
      "displayName": "Mozilla Firefox",
      "publisher": "Mozilla",
      "installerType": "msi",
      "command": "msiexec /i \"{installer}\" /qn /norestart",
      "detection": { "match": "any", "rules": [
        { "type": "file", "target": "%ProgramFiles%\\Mozilla Firefox\\firefox.exe" },
        { "type": "uninstall", "target": "Mozilla Firefox*" }
      ] },
      "timeoutMinutes": 20,
      "verify": false,
      "notes": "Firefox MSI (64-bit, French: lang=fr in the download address; use lang=en-US for English)."
    },
    {
      "name": "VLC",
      "aliases": ["VLC media player", "VideoLAN"],
      "match": ["vlc-*-win64.exe", "vlc-*.exe"],
      "displayName": "VLC media player",
      "publisher": "VideoLAN",
      "installerType": "nsis",
      "command": "\"{installer}\" /L=1033 /S",
      "uninstallCommand": "\"%ProgramFiles%\\VideoLAN\\VLC\\uninstall.exe\" /S",
      "detection": { "match": "all", "rules": [ { "type": "file", "target": "%ProgramFiles%\\VideoLAN\\VLC\\vlc.exe" } ] },
      "timeoutMinutes": 15,
      "verify": false,
      "notes": "NSIS installer. /L=1036 installs it in French."
    },
    {
      "name": "Lansweeper-Agent",
      "aliases": ["Lansweeper", "LsAgent", "LansweeperAgent"],
      "match": ["LsAgent-windows*.exe"],
      "displayName": "Lansweeper LsAgent",
      "publisher": "Lansweeper",
      "installerType": "exe",
      "command": "\"{installer}\" --mode unattended --server REPLACE_SERVER --port 9524",
      "detection": { "match": "all", "rules": [ { "type": "uninstall", "target": "LsAgent*" } ] },
      "timeoutMinutes": 15,
      "verify": true,
      "notes": "Replace REPLACE_SERVER with your Lansweeper server. For a Cloud Relay setup, add --agentkey with your key. Check the uninstall name on a test PC."
    },
    {
      "name": "MirrorOp",
      "aliases": ["MirrorOp Sender", "MirrorOpSender"],
      "match": ["MirrorOp*.exe", "MirrorOp*.msi"],
      "displayName": "MirrorOp",
      "publisher": "",
      "installerType": "",
      "command": "",
      "detection": { "match": "all", "rules": [ { "type": "uninstall", "target": "MirrorOp*" } ] },
      "timeoutMinutes": 15,
      "verify": true,
      "notes": "No known silent switches: the builder suggests them from the installer type. Test on a VM and check the uninstall name."
    },
    {
      "name": "SoftPhone",
      "aliases": ["Softphone"],
      "match": ["*softphone*.exe", "*softphone*.msi"],
      "displayName": "SoftPhone",
      "publisher": "",
      "installerType": "",
      "command": "",
      "detection": { "match": "all", "rules": [ { "type": "uninstall", "target": "*SoftPhone*" } ] },
      "timeoutMinutes": 15,
      "verify": true,
      "notes": "Generic softphone entry: the builder suggests switches from the installer type. Set the detection name to the product's name in Programs and Features."
    }
  ]
}
