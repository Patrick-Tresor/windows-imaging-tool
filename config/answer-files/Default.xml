<?xml version="1.0" encoding="utf-8"?>
<!--
  Answer file: everything one deployment needs.
  Paths are relative to the content root unless absolute (Y:\..., \\server\share\...).
  Passwords: type them in the console's answer file editor. They are saved here encrypted
  (encryptedPassword, administratorEncryptedPassword) with the key in
  config\secrets\answer-key.txt, which the media build puts in boot.wim. Each *PasswordFile only names the
  password (no file is read or written there). Use a join account that can only join computers to one OU.
-->
<deployment version="1.0">
  <!-- Interactive: pick the answer file and type YES. Unattended: start after unattendDelay seconds unless a key is pressed. -->
  <mode>Interactive</mode>
  <unattendDelay>10</unattendDelay>

  <image>
    <file>Images\Win11-Enterprise.wim</file>
    <index>1</index>
    <!-- Empty: the current image. A version (e.g. 20261022-1530) pins this answer file to an earlier copy
         kept in Images\Previous\, which the console's Images > Versions... lists. -->
    <version></version>
  </image>

  <disk>
    <!-- Windows goes on the first internal disk (NVMe, then SATA), never the USB stick. -->
    <!-- Recreate: wipe the disk and create new GPT partitions (EFI, MSR, Windows, Recovery). UEFI only. -->
    <option>Recreate</option>
  </disk>

  <!-- Driver library root (one OEM driver pack per model). Matching uses config\driver-catalog.json. -->
  <drivers>
    <root>Drivers</root>
  </drivers>

  <!-- Installed in this order at first boot, as SYSTEM. Each is a folder under the location with an app.json. -->
  <applications location="Applications">
    <!-- <application order="1">Dell-Command-Update</application> -->
    <!-- <application order="2">Microsoft-Teams</application> -->
  </applications>

  <!-- Leave empty to use the key or activation already in the image (KMS, digital licence). -->
  <productKey></productKey>

  <userInformation>
    <fullName>IT Department</fullName>
    <organization>Contoso</organization>
  </userInformation>

  <!-- Time zone IDs: tzutil /l. Locales: language tags such as en-US, fr-CA.
       inputLocale can list several keyboards separated by ;, the first is the default:
       fr-CA; en-US, or as language:keyboard IDs 0c0c:00001009; 0409:00000409 (Canadian French, then US).
       uiLanguageFallback is only for untranslated text and adds no keyboard; leave empty if not needed.
       The editor asks for the system language and the fallback language and fills these five from them.
       These defaults are the same as Dell Image Assist's: French (Canada) display, Canadian French keyboard first,
       US English keyboard second, English fallback and formats. -->
  <regional>
    <timeZone>Eastern Standard Time</timeZone>
    <inputLocale>0c0c:00001009; 0409:00000409</inputLocale>
    <systemLocale>fr-CA</systemLocale>
    <uiLanguage>fr-CA</uiLanguage>
    <uiLanguageFallback>en-US</uiLanguageFallback>
    <userLocale>en-US</userLocale>
  </regional>

  <identification>
    <!-- The computer name pattern: {SERIAL} = BIOS serial, # = random digit, for example LAB-{SERIAL} or A########.
         Names are cleaned to letters, digits and dashes and cut to 15 characters. -->
    <naming mode="Custom">
      <customScheme>{SERIAL}</customScheme>
      <prefix></prefix>
    </naming>
  </identification>

  <network>
    <!-- Domain or Workgroup -->
    <membership>Workgroup</membership>
    <workgroup>WORKGROUP</workgroup>
    <domain>corp.example.com</domain>
    <organizationalUnit></organizationalUnit>
    <!-- The join account: username is svc-join, CORP\svc-join or svc-join@corp.example.com.
         domain is the account's domain (such as CORP) for a plain user name; empty means the domain above. -->
    <joinCredentials>
      <username>svc-join</username>
      <domain>CORP</domain>
      <passwordFile>config\secrets\join.txt</passwordFile>
    </joinCredentials>
  </network>

  <options>
    <enableAdministrator>false</enableAdministrator>
    <administratorPasswordFile>config\secrets\admin.txt</administratorPasswordFile>
  </options>

  <!-- POSTIMAGE: in WinPE after the image and drivers are applied (%OSDRIVE% = the new Windows drive,
       %DEPLOYROOT% = content root). FIRSTBOOT: on the PC as SYSTEM after the applications.
       FIRSTLOGON: when the first user logs on.
       script="name" runs a task from the task library (<content root>\Tasks\name, the console's Tasks tab) instead
       of a command; the task's text is then extra arguments for its script. -->
  <tasks location="Tasks">
    <!-- <task phase="POSTIMAGE">copy %DEPLOYROOT%\Scripts\*.ps1 %OSDRIVE%\Temp\</task> -->
    <!-- <task phase="FIRSTBOOT">powershell -ExecutionPolicy Bypass -File C:\Temp\Setup.ps1</task> -->
    <!-- <task phase="FIRSTLOGON">powershell -ExecutionPolicy Bypass -File C:\Temp\User.ps1</task> -->
    <!-- <task phase="FIRSTBOOT" script="Set-Wallpaper">-Path C:\Windows\Web\Wallpaper\School.jpg</task> -->
  </tasks>

  <!-- BitLocker on the OS drive, turned on at first boot as SYSTEM after the applications and FIRSTBOOT tasks.
       The recovery password is backed up first; with requireBackup, BitLocker stays off if no backup worked.
       Always TPM only (no startup PIN) and XTS-AES 256.
       backupToAD: store the recovery password on the computer object (domain only).
       recoveryKeyFolder: \\server\share folder that Domain Computers can write to; one text file per PC. -->
  <bitlocker>
    <enabled>false</enabled>
    <usedSpaceOnly>true</usedSpaceOnly>
    <backupToAD>true</backupToAD>
    <recoveryKeyFolder></recoveryKeyFolder>
    <requireBackup>true</requireBackup>
  </bitlocker>

  <completion>
    <reboot>true</reboot>
    <shutdown>false</shutdown>
  </completion>
</deployment>
